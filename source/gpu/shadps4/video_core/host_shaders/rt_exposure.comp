#version 460
#extension GL_EXT_samplerless_texture_functions : require

// Eye adaptation for the path-traced image (BB_RT_EXPOSURE). The game's exposure is fixed per
// area and tuned for its own lighting, which adds a camera-side ambient and fill; traced light has
// none, so a view facing the moon (backlit, Hemwick's lily field) came out at a third of stock.
// Like an eye or a camera, this measures how bright the lit geometry is (log-average luminance of
// a 64x36 grid of non-sky pixels of the HDR scene colour at the post trigger, before the game's
// bloom and tonemap) and brightens the geometry toward a key, never darkening and at most
// BB_RT_EXPOSURE_MAX stops, adapting a little each frame. No light is added: shadow ratios in the
// dark range keep, highlights roll off and the sky is left as the game draws it. With the effects paused (F9) it only measures, so the
// key can be set from the stock frame.
//
// Phase 0: one workgroup measures and updates state[0] = (ev, measured log2, samples, gain);
//          paused, it writes the measure to state[1].x and leaves the gain alone.
// Phase 1: one thread per pixel multiplies the non-sky scene colour by the gain, rolled off
//          toward the white level so highlights keep their value.

layout(local_size_x = 256) in;

layout(binding = 0) uniform texture2D depth_tex;
layout(binding = 1, rgba16f) uniform image2D scene_img;
layout(binding = 2, std430) buffer State {
    vec4 state[];
};

layout(push_constant) uniform Push {
    vec4 size_cfg; // width, height, phase, apply (1) or measure only (0)
    vec4 params;   // key (log2 luminance), max boost (stops), rate per frame, reset (1)
    vec4 tone;     // white level (stops above the key) where the boost has faded out
};

const uint GridX = 64u;
const uint GridY = 36u;
const uint MinSamples = 64u;

shared float s_sum[256];
shared float s_count[256];

bool Finite(vec3 v) {
    return !any(isnan(v)) && !any(isinf(v));
}

void main() {
    const ivec2 size = ivec2(size_cfg.xy);
    const uint phase = uint(size_cfg.z);
    const bool apply = size_cfg.w > 0.5;
    if (phase == 1u) {
        const uint index = gl_GlobalInvocationID.x;
        const ivec2 pixel = ivec2(int(index % uint(size.x)), int(index / uint(size.x)));
        if (pixel.y >= size.y) {
            return;
        }
        const float gain = state[0].w;
        if (!(gain > 1.0) || isinf(gain)) {
            return;
        }
        // The sky keeps the game's look: boosting it with the geometry blew it to white.
        const float depth = texelFetch(depth_tex, pixel, 0).r;
        if (!(depth < 1.0) || depth < 0.0) {
            return;
        }
        const vec4 c = imageLoad(scene_img, pixel);
        if (!Finite(c.rgb)) {
            return;
        }
        // Highlight roll-off: dark pixels get the full gain, which fades smoothly to none at the
        // white level (tone.x stops above the key), so lit fog and bright surfaces do not clip.
        // out = L g / (1 + (g - 1) L / W) for L < W is monotonic and meets L at W.
        const float white = exp2(params.x + tone.x);
        const float lum = dot(max(c.rgb, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
        if (lum >= white) {
            return;
        }
        const float k = gain / (1.0 + (gain - 1.0) * lum / white);
        imageStore(scene_img, pixel, vec4(c.rgb * k, c.a));
        return;
    }
    const uint t = gl_LocalInvocationIndex;
    float sum = 0.0, count = 0.0;
    for (uint i = t; i < GridX * GridY; i += 256u) {
        const vec2 uv = (vec2(float(i % GridX), float(i / GridX)) + 0.5) / vec2(GridX, GridY);
        const ivec2 pixel = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
        const float depth = texelFetch(depth_tex, pixel, 0).r;
        if (!(depth < 1.0) || depth < 0.0) {
            continue; // sky or invalid
        }
        const vec3 c = imageLoad(scene_img, pixel).rgb;
        if (!Finite(c)) {
            continue;
        }
        const float lum = dot(max(c, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
        sum += log2(max(lum, 1e-4));
        count += 1.0;
    }
    s_sum[t] = sum;
    s_count[t] = count;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (t < stride) {
            s_sum[t] += s_sum[t + stride];
            s_count[t] += s_count[t + stride];
        }
        barrier();
    }
    if (t != 0u) {
        return;
    }
    vec4 s = state[0];
    if (params.w > 0.5 || !(s.w >= 1.0) || isnan(s.x) || isinf(s.x)) {
        s = vec4(0.0, 0.0, 0.0, 1.0);
    }
    const float n = s_count[0];
    const bool measured = n >= float(MinSamples);
    const float mean = measured ? s_sum[0] / n : s.y;
    if (!apply) {
        state[1] = vec4(mean, n, 0.0, 0.0);
        return;
    }
    if (measured) {
        const float target = clamp(params.x - mean, 0.0, max(params.y, 0.0));
        s.x += (target - s.x) * clamp(params.z, 0.0, 1.0);
    }
    s.y = mean;
    s.z = n;
    s.w = exp2(s.x);
    state[0] = s;
}
