                }
                hist += h.rgb * weight;
                hist_count += h.a * weight;
                weight_sum += weight;
            }
            if (weight_sum > 1e-3) {
                hist /= weight_sum;
                hist_count /= weight_sum;
                const float n_samples = min(hist_count, MaxHistory()) + 1.0;
                accumulated = mix(hist, raw, 1.0 / n_samples);
                count = n_samples;
            }
        }
    }
    if (!Finite(accumulated)) {
        accumulated = raw;
        count = 1.0;
    }
    imageStore(history_out, pixel, vec4(accumulated, count));
    imageStore(history_z_out, pixel, vec4(p.z, 0.0, 0.0, 0.0));
}

void main() {
#ifdef RT_RESTIR_INIT
    const uint sparse = Sparse();
    const uvec2 block_size = sparse >= 4u ? uvec2(2u, 2u) : sparse == 2u ? uvec2(2u, 1u) : uvec2(1u);
    const uint count = block_size.x * block_size.y;
    const uvec2 block = GI_INVOCATION.xy;
    const bool full = count == 1u || (Flags() & FlagReset) != 0u;
    const uint first = (SparsePhase() + Hash(block.x * 7919u + block.y * 104729u)) % count;
    for (uint k = 0u; k < count; ++k) {
        const uint index = (first + k) % count;
        const uvec2 offset = uvec2(index % block_size.x, index / block_size.x);
        Shade(ivec2(block * block_size + offset), full || k == 0u);
    }
#else
    Shade(ivec2(GI_INVOCATION.xy), true);
#endif
}
#endif
