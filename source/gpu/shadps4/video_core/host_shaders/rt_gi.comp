float ReflectStrength() { return strength_bias.x; }
float ReflectMaxRough() { return strength_bias.z; }
uint ReflectFlags() { return bounce_cfg.z; }
uint ReflectDebug() { return bounce_cfg.w; }

vec3 GgxHalfVector(vec3 n, float alpha, inout uint state) {
    const float u1 = Random(state);
    const float u2 = Random(state);
    const float a2 = alpha * alpha;
    const float cos_theta = sqrt(max(0.0, (1.0 - u1) / (1.0 + (a2 - 1.0) * u1)));
    const float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    const float phi = 6.28318530718 * u2;
    const vec3 helper = abs(n.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    const vec3 tangent = normalize(cross(helper, n));
    const vec3 bitangent = cross(n, tangent);
    return normalize(tangent * (sin_theta * cos(phi)) + bitangent * (sin_theta * sin(phi)) +
                     n * cos_theta);
}

float GgxG1(float alpha, float n_dot_x) {
    const float a2 = alpha * alpha;
    const float c = max(n_dot_x, 1e-4);
    return 2.0 * c / (c + sqrt(a2 + (1.0 - a2) * c * c));
}

vec3 ReflectTarget(ivec2 pixel) {
    const vec3 current = imageLoad(reflect_spec_out, pixel).rgb;
    return Finite(current) ? max(current, vec3(0.0)) : vec3(0.0);
}

void ReflectStore(ivec2 pixel, vec3 spec, float hit_distance) {
    if (!Finite(spec)) {
        spec = vec3(0.0);
    }
    imageStore(reflect_spec_out, pixel, vec4(clamp(spec, vec3(0.0), vec3(ReflectMaxOutput)), 1.0));
    imageStore(reflect_hit_out, pixel, vec4(hit_distance, 0.0, 0.0, 0.0));
}

void ReflectKeep(ivec2 pixel) {
    imageStore(reflect_hit_out, pixel, vec4(0.0));
    if (glass_push.base_cut > 0.0) {
        imageStore(reflect_spec_out, pixel,
                   vec4(ReflectTarget(pixel) * (1.0 - clamp(glass_push.base_cut, 0.0, 1.0)), 1.0));
    }
}

// A glossy pixel is glass when the camera ray through it first hits, at the pixel's depth, an
// instance drawn by a BB_RT_GLASS_PS shader (SurfaceGlass in its surface record). The pane's own
// texture (no decals) comes back in pane.
bool GlassFind(vec3 p, out float t_pane, out Surface pane, out bool mirror) {
    t_pane = 0.0;
    mirror = false;
    pane = EmptySurface();
    const float dist = length(p);
    if (dist <= 1e-4) {
        return false;
    }
    const vec3 dir = p / dist;
    const float window = GlassDepthWindow * dist + GlassDepthSlack;
    trace_through_glass = false;
    uint id, primitive;
    vec2 barycentrics;
    mat3 rotation;
    uint rejected = 0u;
    const float t = TraceSpan(vec3(0.0), dir, max(dist - window, 0.0), dist + window,
                              MaskSolid | MaskKept, id, primitive,
                              barycentrics, rotation, rejected);
    if (t < 0.0 || !GlassAt(id, primitive, barycentrics)) {
        return false;
    }
    pane = HitSurface(id, primitive, barycentrics, rotation);
    // The gap is measured along the pane normal, so a mirror seen at a slant is still caught.
    const float cos_view = pane.valid ? abs(dot(pane.normal, dir)) : 1.0;
    const float t_end = t + GlassBackedGap / max(cos_view, 0.25);
    float t_back = t + 0.002;
    for (int k = 0; k < 4; ++k) {
        uint back_id, back_prim;
        vec2 back_bary;
        mat3 back_rot;
        uint back_rejected = 0u;
        const float tb = TraceSpan(vec3(0.0), dir, t_back, t_end, MaskSolid | MaskKept,
                                   back_id, back_prim, back_bary, back_rot, back_rejected);
        if (tb < 0.0) {
            break;
        }
        // Another draw, opaque, right behind: a backing board. The bottles' own liquid (same
        // instance, outside the glass mask) does not count.
        if (back_id != id && !GlassAt(back_id, back_prim, back_bary)) {
            pane = EmptySurface();
            mirror = true;
            return false;
        }
        t_back = tb + 0.002;
    }
    t_pane = t;
    return true;
}

bool FlameLight(DirectLight light) {
    return light.spec_kind.w < 0.5 && light.color_sp.b < FlameWarm * light.color_sp.r &&
           (uint(light.wrap_r_flag.w + 0.5) & 8u) == 0u;
}

float SpriteCore(vec3 c, vec3 o, vec3 l, float t_hit, vec3 up, float width, float height,
                 float slack) {
    const float s = dot(c - o, l);
    if (s <= 0.0 || (t_hit >= 0.0 && s > t_hit + slack)) {
        return 0.0;
    }
    const vec3 d = c - (o + l * s);
    const float dv = dot(d, up) / height;
    const vec3 dh = (d - up * dot(d, up)) / width;
    const float r2 = dot(dh, dh) + dv * dv;
    return r2 < 4.0 ? exp(-3.0 * r2) : 0.0;
}

float FlameCore(vec3 c, vec3 o, vec3 l, float t_hit, vec3 up, float radius, float slack) {
    return SpriteCore(c, o, l, t_hit, up, radius, FlameHeight * radius, slack);
}

uint FlameFxCount() {
    return min(light_grid[FlameFxBase], FlameFxMax);
}

vec3 FlameFxPoint(uint k) {
    const uint w = FlameFxBase + 4u + 4u * k;
    return uintBitsToFloat(uvec3(light_grid[w], light_grid[w + 1u], light_grid[w + 2u]));
}

bool WispFx(uint k) {
    return light_grid[FlameFxBase + 7u + 4u * k] == 1u;
}

bool NearFlameFx(vec3 p) {
    const uint n = FlameFxCount();
    for (uint k = 0u; k < n; ++k) {
        if (WispFx(k)) {
            continue;
        }
        const vec3 gap = FlameFxPoint(k) - p;
        if (dot(gap, gap) < FlameMerge * FlameMerge) {
            return true;
        }
    }
    return false;
}

vec3 FlameImage(vec3 o, vec3 l, float t_hit) {
    vec3 result = vec3(0.0);
    const vec3 up = normalize(vec3(view_rows[0].y, view_rows[1].y, view_rows[2].y));
    const uint fx = FlameFxCount();
    for (uint k = 0u; k < fx; ++k) {
        const bool wisp = WispFx(k);
        const float core =
            wisp ? SpriteCore(FlameFxPoint(k), o, l, t_hit, up, WispFxWidth,
                              FlameHeight * WispFxRadius, FlameFxSlack)
                 : FlameCore(FlameFxPoint(k), o, l, t_hit, up, FlameFxRadius, FlameFxSlack);
        const vec3 tint = wisp ? WispFxColor : FlameFxColor;
        result += mix(tint, vec3(tint.r), 0.3 * core) * ((wisp ? WispGain : FlameGain) * core);
    }
    const uint count = min(LightCount(), MaxGiLights);
    uint first, last, entries;
    bool grid;
    LightCell(o, first, last, entries, grid);
    for (uint k = first; k < last; ++k) {
        const uint i = grid ? light_grid[entries + k] : k;
        if (i >= count) {
            continue;
        }
        const DirectLight light = lights[i];
        if (!FlameLight(light)) {
            continue;
        }
        const float core = FlameCore(light.pos_inv_r2.xyz + up * (FlameLift * FlameRadius), o, l,
                                     t_hit, up, FlameRadius, 0.0);
        if (core <= 0.0 || NearFlameFx(light.pos_inv_r2.xyz)) {
            continue;
        }
        const float power = dot(light.color_sp.rgb, vec3(1.0));
        bool beaten = false;
        for (uint m = first; m < last && !beaten; ++m) {
            const uint j = grid ? light_grid[entries + m] : m;
            if (j == i || j >= count) {
                continue;
            }
            const DirectLight other = lights[j];
            if (!FlameLight(other)) {
                continue;
            }
            const vec3 gap = other.pos_inv_r2.xyz - light.pos_inv_r2.xyz;
            const float other_power = dot(other.color_sp.rgb, vec3(1.0));
            beaten = dot(gap, gap) < FlameMerge * FlameMerge && (other_power > power || (other_power == power && j < i));
        }
        if (beaten) {
            continue;
        }
        const vec3 hot = vec3(max(light.color_sp.r, max(light.color_sp.g, light.color_sp.b)));
        result += mix(light.color_sp.rgb, hot, 0.3 * core) * (FlameGain * core);
    }
    return result;
}

vec3 MistLamp(vec3 q) {
    if ((BounceFlags() & BounceFlagLights) == 0u) {
        return vec3(0.0);
    }
    const uint count = min(LightCount(), MaxGiLights);
    uint first, last, entries;
    bool grid;
    LightCell(q, first, last, entries, grid);
    vec3 total = vec3(0.0);
    float chosen_w = 0.0;
    vec3 chosen_d = vec3(0.0);
    for (uint k = first; k < last; ++k) {
        const uint i = grid ? light_grid[entries + k] : k;
        if (i >= count) {
            continue;
        }
        const DirectLight l = lights[i];
        const vec3 d = l.pos_inv_r2.xyz - q;
        const float d2 = dot(d, d);
        const float inv_r2 = l.pos_inv_r2.w;
        if (d2 <= 1e-8 || d2 * inv_r2 >= 1.0) {
            continue;
        }
        float cone = 1.0;
        float atten = max(0.0, 1.0 / d2 - inv_r2);
        if (l.spec_kind.w > 0.5) {
            const vec4 hp = vec4(q, 1.0);
            const vec4 s = vec4(dot(l.cone[0], hp), dot(l.cone[1], hp), dot(l.cone[2], hp), dot(l.cone[3], hp));
            if (s.z <= 0.0 || s.w == 0.0) {
                continue;
            }
            const vec2 xy = s.xy / s.w;
            const float disc = clamp(1.0 - dot(xy, xy), 0.0, 1.0);
            if (l.spec_kind.w < 1.5) {
                cone = disc;
            } else {
                const float axial = clamp(1.0 - s.w / l.wrap_r_flag.z, 0.0, 1.0);
                cone = disc * disc * axial * axial;
                atten = 1.0;
            }
            if (cone <= 0.0) {
                continue;
            }
        }
        if ((uint(l.wrap_r_flag.w + 0.5) & 1u) != 0u) {
            const float legacy_f = 1.0 - sqrt(clamp(d2 * inv_r2, 0.0, 1.0));
            atten = legacy_f * legacy_f;
        }
        if ((uint(l.wrap_r_flag.w + 0.5) & 4u) != 0u) {
            const float s2 = l.wrap_r_flag.z;
            atten = max(0.0, s2 / (d2 + s2) - s2 / (1.0 / inv_r2 + s2)) *
                    HousingFade(uint(l.wrap_r_flag.w + 0.5), d2);
        }
        const vec3 e = max(l.color_sp.rgb, vec3(0.0)) * (atten * cone);
        const float w = dot(e, vec3(1.0));
        if (!(w > 0.0) || !Finite(e)) {
            continue;
        }
        total += e;
        if (w > chosen_w) {
            chosen_w = w;
            chosen_d = d;
        }
    }
    const float dist = length(chosen_d);
    if (!(chosen_w > 0.0) || dist <= 1e-3) {
        return vec3(0.0);
    }
    return total * Transmittance(q, chosen_d / dist, max(dist - BounceGap(), 1e-3));
}

const float MistTop = 4.0;
const float MistScale = 0.45;
const vec3 MistWind = vec3(0.12, 0.02, 0.07);

float MistValue(vec3 p) {
    const vec3 i = floor(p);
    const vec3 f = p - i;
    const vec3 u = f * f * (3.0 - 2.0 * f);
    const uvec3 c = uvec3(ivec3(i) + ivec3(1 << 20));
    float v[8];
    for (uint k = 0u; k < 8u; ++k) {
        const uvec3 o = uvec3(k & 1u, (k >> 1u) & 1u, k >> 2u);
        const uvec3 cc = c + o;
        v[k] = float(Hash(cc.x * 73856093u ^ cc.y * 19349663u ^ cc.z * 83492791u) & 0xFFFFu) / 65535.0;
    }
    return mix(mix(mix(v[0], v[1], u.x), mix(v[2], v[3], u.x), u.y),
               mix(mix(v[4], v[5], u.x), mix(v[6], v[7], u.x), u.y), u.z);
}

float MistNoise(vec3 w, float time) {
    const vec3 p = w * MistScale - MistWind * time;
    const vec3 warp = vec3(MistValue(p * 0.6 + vec3(time * 0.11, 0.0, 0.0)),
                           MistValue(p * 0.6 + vec3(5.2, time * 0.13, 1.3)),
                           MistValue(p * 0.6 + vec3(2.1, 7.7, time * 0.09))) - 0.5;
    const vec3 r = p + warp * 1.6;
    const float n = 0.6 * MistValue(r) + 0.4 * MistValue(r * 2.3 + vec3(17.1, 3.7 + time * 0.2, 9.2));
    const float lo = clamp(glass_push.mist_patch, 0.0, 0.9);
    return smoothstep(lo, min(lo + 0.3, 1.0), n) * 2.0;
}

const float MistReach = 30.0;
const float MistFar = 300.0;
const vec3 MistGlowTint = vec3(0.80, 0.95, 0.92);
const float MistFall = 0.35;
const float MistLift = 12.0;
const vec2 MistGlowNear = vec2(1.5, 8.0);
const float MistSwellScale = 0.15;
const uint FogFxBase = FlameFxBase + 4u + 4u * FlameFxMax;
const uint FogFxMax = 1024u;

// Lamp halos seen along a mirror ray (o, l up to t_hit): the halo block after the fog block
// (count, strength, radius, core, then 8 floats per halo, Rt::BuildHalos), the same Gaussian line
// integral and flame tint as HaloGlow in rt_gi_apply.comp.
const vec3 HaloTint = vec3(1.0, 0.5, 0.22);
const uint HaloFxMax = 16u;
vec3 MirrorHalos(vec3 o, vec3 l, float t_hit) {
    const uint base = FogFxBase + 4u + 4u * FogFxMax;
    const uint n = min(light_grid[base], HaloFxMax);
    const float len = t_hit < 0.0 ? 1.0e4 : t_hit;
    vec3 sum = vec3(0.0);
    for (uint k = 0u; k < n; ++k) {
        const uint w = base + 4u + 8u * k;
        const vec3 p = uintBitsToFloat(uvec3(light_grid[w], light_grid[w + 1u], light_grid[w + 2u])) - o;
        const float radius = uintBitsToFloat(light_grid[w + 3u]);
        const vec3 ic = uintBitsToFloat(uvec3(light_grid[w + 4u], light_grid[w + 5u], light_grid[w + 6u]));
        const float core = uintBitsToFloat(light_grid[w + 7u]);
        const float b = dot(p, l);
        const float h2 = max(dot(p, p) - b * b, 0.0);
        const float r2 = radius * radius;
        if (b <= 0.0 || !(r2 > 0.0) || h2 >= 9.0 * r2) {
            continue;
        }
        const float hh = sqrt(h2 + core * core);
        const float glow = (atan((len - b) / hh) + atan(b / hh)) / hh * exp(-h2 / r2);
        const float peak = max(max(ic.r, ic.g), ic.b);
        sum += HaloTint * (max(peak, 0.0) * glow);
    }
    return Finite(sum) ? sum : vec3(0.0);
}
const uint MistSheetMax = 8u;
const float MistSheetNoise = 0.5;

float MistBlob(vec3 q, vec4 c) {
    const vec3 d = q - c.xyz;
    const float x = clamp(1.0 - dot(d, d) / (c.w * c.w), 0.0, 1.0);
    return x * x;
}

bool MistLevel(vec3 origin, vec3 down, vec3 ay, vec3 cam, out float level) {
    level = 0.0;
    uint id, primitive;
    vec2 barycentrics;
    mat3 rotation;
    uint rejected = 0u;
    const float t = TraceSpan(origin, down, 0.0, MistReach, MaskWater, id, primitive, barycentrics,
                              rotation, rejected);
    if (t < 0.0 || id >= surfaces.length()) {
        return false;
    }
    level = dot(ay, origin + down * t - cam);
    return true;
}

void MistVolume(vec3 p, bool sheet, vec3 sheet_p, ivec2 pixel, uint set_id, out float mist_t, out vec3 mist_in) {
    mist_t = 1.0;
    mist_in = vec3(0.0);
    const float len = length(p);
    if (len <= 1e-3) {
        return;
    }
    const vec3 dir = p / len;
    const float dist = min(len, MistFar);
    const vec3 ax = vec3(view_rows[0].x, view_rows[1].x, view_rows[2].x);
    const vec3 ay = vec3(view_rows[0].y, view_rows[1].y, view_rows[2].y);
    const vec3 az = vec3(view_rows[0].z, view_rows[1].z, view_rows[2].z);
    const vec3 cam = vec3(view_rows[0].w, view_rows[1].w, view_rows[2].w);
    const vec3 down = -normalize(ay);
    const bool fog = glass_push.mist_sheet > 0.0;
    vec4 fog_c[MistSheetMax];
    float fog_a[MistSheetMax];
    float fog_p[MistSheetMax];
    vec3 fog_rgb[MistSheetMax];
    uint fog_n = 0u;
    float level = 0.0;
    float lift = 0.0;
    float band = 1.0;
    float h0 = 0.0;
    float dh = 0.0;
    float t_e = 0.0;
    float t_s = dist;
    if (fog) {
        const uint fog_count = min(light_grid[FogFxBase], FogFxMax);
        for (uint k = 0u; k < fog_count; ++k) {
            const uint wd = FogFxBase + 4u + 4u * k;
            const uvec3 cw = uvec3(light_grid[wd], light_grid[wd + 1u], light_grid[wd + 2u]);
            const vec3 c = uintBitsToFloat(cw & ~0xFFu);
            const uint packed = light_grid[wd + 3u];
            const float r = uintBitsToFloat(packed & ~0xFFu);
            const float a = float(packed & 0xFFu) / 255.0;
            if (!(r > 0.0) || a <= 0.0) {
                continue;
            }
            const float tc = dot(c, dir);
            const float d2 = dot(c, c) - tc * tc;
            if (d2 >= r * r || tc + r <= 0.0 || tc - r >= dist) {
                continue;
            }
            const float x = 1.0 - d2 / (r * r);
            const float peak = a * x * x;
            uint slot = fog_n;
            if (fog_n < MistSheetMax) {
                ++fog_n;
            } else {
                slot = 0u;
                for (uint m = 1u; m < MistSheetMax; ++m) {
                    slot = fog_p[m] < fog_p[slot] ? m : slot;
                }
                if (peak <= fog_p[slot]) {
                    continue;
                }
            }
            fog_c[slot] = vec4(c, r);
            fog_a[slot] = a;
            fog_p[slot] = peak;
            fog_rgb[slot] = vec3(cw & 0xFFu) / 255.0;
        }
        if (fog_n == 0u) {
            return;
        }
        float lo = 1e30;
        float hi = 0.0;
        for (uint k = 0u; k < fog_n; ++k) {
            const float tc = dot(fog_c[k].xyz, dir);
            const float half_w = sqrt(max(fog_c[k].w * fog_c[k].w - (dot(fog_c[k].xyz, fog_c[k].xyz) - tc * tc), 0.0));
            lo = min(lo, tc - half_w);
            hi = max(hi, tc + half_w);
        }
        t_e = max(lo, 0.0);
        t_s = min(hi, dist);
    } else {
        level = sheet ? dot(ay, sheet_p - cam) : 0.0;
        bool found = sheet;
        if (!found) {
            found = MistLevel(dir * max(dist - 0.1, 0.0) - down * 0.2, down, ay, cam, level);
        }
        if (!found) {
            found = MistLevel(dir * (dist * 0.5), down, ay, cam, level);
        }
        if (!found) {
            found = MistLevel(vec3(0.0), down, ay, cam, level);
        }
        if (!found) {
            return;
        }
        float cam_level = level;
        lift = MistLevel(vec3(0.0), down, ay, cam, cam_level) ? clamp(cam_level - level, 0.0, MistLift) : 0.0;
        band = glass_push.mist_height * MistTop;
        const float top = lift + band;
        h0 = dot(ay, -cam) - level;
        dh = dot(ay, dir);
        if (abs(dh) < 1e-5) {
            if (h0 < 0.0 || h0 > top) {
                return;
            }
        } else {
            const float ta = -h0 / dh;
            const float tb = (top - h0) / dh;
            t_e = max(t_e, min(ta, tb));
            t_s = min(t_s, max(ta, tb));
        }
    }
    if (t_s <= t_e) {
        return;
    }
    const uint steps = max(uint(glass_push.mist_steps + 0.5), 1u);
    const float dt = (t_s - t_e) / float(steps);
    const vec2 ign = vec2(pixel) + 5.588238 * float(Frame() & 63u);
    const float jitter = fract(52.9829189 * fract(dot(ign, vec2(0.06711056, 0.00583715))));
    const float time = float(Frame()) / 60.0;
    const uint half_steps = (steps + 1u) / 2u;
    vec2 wsum = vec2(0.0);
    vec3 near_q = vec3(0.0);
    vec3 far_q = vec3(0.0);
    vec3 glow_c = vec3(0.0);
    for (uint i = 0u; i < steps; ++i) {
        const float t = t_e + (float(i) + jitter) * dt;
        const vec3 q = dir * t;
        const vec3 w = vec3(dot(ax, q - cam), dot(ay, q - cam), dot(az, q - cam));
        float density;
        vec3 tint = vec3(1.0);
        if (fog) {
            float s = 0.0;
            vec3 sc = vec3(0.0);
            for (uint k = 0u; k < fog_n; ++k) {
                const float b = fog_a[k] * MistBlob(q, fog_c[k]);
                s += b;
                sc += b * fog_rgb[k];
            }
            tint = s > 1e-6 ? sc / s : vec3(1.0);
            density = glass_push.mist * s * mix(1.0, MistNoise(w, time), MistSheetNoise);
        } else {
            const float h = max(h0 + dh * t, 0.0);
            const float swell = MistValue(vec3(w.x, 0.0, w.z) * MistSwellScale + vec3(0.0, time * 0.05, 0.0));
            const float scale_h = max(glass_push.mist_height * (0.3 + 1.4 * swell), 1e-3);
            const float fade = 1.0 - clamp(max(h - lift, 0.0) / band, 0.0, 1.0);
            density = glass_push.mist * exp(-max(h - lift - scale_h, 0.0) / (MistFall * scale_h)) * fade * fade * MistNoise(w, time);
        }
        const float step_t = exp(-density * dt);
        const float wi = mist_t * (1.0 - step_t);
        if (i < half_steps) {
            wsum.x += wi;
            near_q += wi * q;
        } else {
            wsum.y += wi;
            far_q += wi * q;
        }
        glow_c += wi * smoothstep(MistGlowNear.x, MistGlowNear.y, t) * tint;
        mist_t *= step_t;
    }
    if (wsum.x > 1e-4) {
        mist_in += wsum.x * MistLamp(near_q / wsum.x);
    }
    if (wsum.y > 1e-4) {
        mist_in += wsum.y * MistLamp(far_q / wsum.y);
    }
    mist_in *= glass_push.mist_albedo / (4.0 * 3.14159265);
    const float wall = wsum.x + wsum.y;
    const uint fog_base = set_id * 6u + 1u;
    if (glass_push.mist_fog > 0.0 && fog_base + 3u < fog_sets.length()) {
        const vec3 fog_col = fog_sets[fog_base + 3u].rgb;
        if (Finite(fog_col)) {
            mist_in += glow_c * glass_push.mist_fog * max(fog_col, vec3(0.0));
        }
    } else if (glass_push.mist_glow > 0.0 && wall > 1e-4) {
        const float lit = clamp(Luma(mist_in / wall) / glass_push.mist_glow, 0.0, 1.0);
        mist_in += glow_c * glass_push.mist_glow * mix(glass_push.mist_glow_dark, 1.0, lit) * MistGlowTint;
    }
    mist_in = Finite(mist_in) ? clamp(mist_in, vec3(0.0), vec3(Clamp())) : vec3(0.0);
}

const float WaterRippleFade = 40.0;
const float WaterRippleFps = 60.0;

vec3 WaterRipple(vec3 p, vec3 n, float slope) {
    const vec3 ax = vec3(view_rows[0].x, view_rows[1].x, view_rows[2].x);
    const vec3 ay = vec3(view_rows[0].y, view_rows[1].y, view_rows[2].y);
    const vec3 az = vec3(view_rows[0].z, view_rows[1].z, view_rows[2].z);
    const vec3 t = vec3(view_rows[0].w, view_rows[1].w, view_rows[2].w);
    const vec2 w = vec2(dot(ax, p - t), dot(az, p - t));
    const float fade = clamp(1.0 - length(p) / WaterRippleFade, 0.0, 1.0);
    if (fade <= 0.0 || abs(dot(n, ay)) < 0.7) {
        return n;
    }
    const float time = float(Frame()) / WaterRippleFps;
    const vec4 waves[6] = vec4[6](vec4(0.83, 0.56, 5.1, 1.3), vec4(-0.42, 0.91, 7.3, 1.7),
                                  vec4(0.21, -0.98, 11.9, 2.3), vec4(-0.95, -0.31, 17.3, 2.9),
                                  vec4(0.64, -0.77, 23.7, 3.7), vec4(-0.12, 0.99, 31.1, 4.3));
    vec2 grad = vec2(0.0);
    for (int i = 0; i < 6; ++i) {
        const float k = waves[i].z;
        const float phase = dot(waves[i].xy, w) * k + time * waves[i].w;
        grad += waves[i].xy * (cos(phase) / sqrt(k));
    }
    grad *= slope * fade;
    vec3 rn = normalize(ay - ax * grad.x - az * grad.y);
    return dot(n, ay) < 0.0 ? -rn : rn;
}

// Blood under sheet water: the splats are only in the G-buffer albedo (decals), and they are
// red where stone is near grey (brown cobbles ~0.2, blood ~0.75-0.9 on this scale). Comparing
// with the floor's own texture failed on layered materials (one texture of several traced).
float WaterDecalCover(ivec2 pixel) {
    if ((glass_push.flags & GlassAlbedo) == 0u) {
        return 0.0;
    }
    const vec3 a = texelFetch(albedo_tex, pixel, 0).rgb;
    if (!Finite(a)) {
        return 0.0;
    }
    const vec3 g = clamp(a, vec3(0.0), vec3(1.0));
    const float red = (g.r - max(g.g, g.b)) / max(g.r, 0.02);
    return smoothstep(WaterCoverLo, WaterCoverHi, red);
}

// Coplanar copies of a floor sit within this fraction of the distance of each other.
const float WaterCopySlack = 0.002;

// puddle_ok: the pixel is glossy enough to be a puddle (WaterPuddleGloss), else only sheets count.
uint WaterFind(vec3 p, bool puddle_ok, out vec3 water_p, out vec3 water_n, out float water_depth) {
    water_p = p;
    water_n = vec3(0.0);
    water_depth = 0.0;
    const float dist = length(p);
    if (dist <= 1e-4) {
        return 0u;
    }
    const vec3 dir = p / dist;
    const float window = GlassDepthWindow * dist + GlassDepthSlack;
    uint sheet_id, sheet_primitive;
    vec2 sheet_barycentrics;
    mat3 sheet_rotation;
    uint sheet_rejected = 0u;
    const float sheet_max = glass_push.sheet_depth < 0.0 ? dist + window : dist - glass_push.sheet_depth;
    const vec3 up = normalize(vec3(view_rows[0].y, view_rows[1].y, view_rows[2].y));
    const float down = abs(dot(dir, up));
    const float lift = glass_push.raise > 0.0 && down > 0.02 ? glass_push.raise / down : 0.0;
    const float t_sheet = sheet_max <= 0.0 || (glass_push.flags & WaterSheets) == 0u ? -1.0 :
                          TraceSpan(vec3(0.0), dir, 0.0, sheet_max + lift, MaskWater, sheet_id,
                                    sheet_primitive, sheet_barycentrics, sheet_rotation,
                                    sheet_rejected);
    if (t_sheet >= 0.0 && sheet_id < surfaces.length()) {
        water_n = dot(up, dir) > 0.0 ? -up : up;
        const float t_top = max(t_sheet - lift, 0.0);
        water_depth = max(dist - t_top, 0.0);
        if ((glass_push.flags & WaterAtFloor) == 0u) {
            water_p = dir * t_top;
        }
        return 3u;
    }
    if (!puddle_ok || (glass_push.flags & WaterPuddles) == 0u) {
        return 0u;
    }
    // Every surface in the window, not only the closest: a puddle floor often has a coplanar copy
    // (kept from an earlier frame, or a second draw), and which copy wins the closest hit changes
    // with the view angle, so the puddles blinked between mirror and dry stone while moving.
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_frame_flags.xy), gl_RayFlagsNoOpaqueEXT,
                          MaskSolid | MaskKept, TlasPoint(tlas_frame_flags.xy, vec3(0.0)),
                          max(dist - window, 0.0), TlasDir(tlas_frame_flags.xy, dir), dist + window);
    float t_any = 1e30;
    float t_water = 1e30;
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
            continue;
        }
        const float t = rayQueryGetIntersectionTEXT(q, false);
        const uint id = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false));
        t_any = min(t_any, t);
        if (id < surfaces.length() && (surfaces[id].flags & SurfaceWater) != 0u) {
            t_water = min(t_water, t);
        }
    }
    if (t_any > 1e29) {
        return 0u;
    }
    return t_water <= t_any + WaterCopySlack * dist + 0.01 ? 2u : 1u;
}

// Radiance arriving through a thin pane along the camera ray: the ray goes on straight (no
// refraction offset) from t_start, past the pane's back face, and its hit is shaded like a
// reflection hit.
vec3 GlassBehind(vec3 dir, float t_start, uint set_id) {
    uint id, primitive;
    vec2 barycentrics;
    mat3 rotation;
    uint rejected = 0u;
    trace_through_glass = true;
    // MaskKept too: the room behind a pane is often not drawn this frame (the game culls it
    // behind the door), only kept from earlier frames; without it the ray reached the sky.
    const float t = TraceSpan(vec3(0.0), dir, t_start, 1e6, MaskSolid | MaskKept, id, primitive,
                              barycentrics, rotation, rejected);
    trace_through_glass = false;
    vec3 radiance;
    if (t < 0.0) {
        radiance = SkyRadiance(dir);
    } else {
        const vec3 hit = dir * t;
        const Surface surface = HitSurface(id, primitive, barycentrics, rotation);
        const vec3 albedo = surface.valid ? surface.albedo : vec3(UnknownAlbedo);
        vec3 hn = surface.normal;
        if (dot(hn, hn) < 0.5) {
            hn = -dir;
        } else if (dot(hn, dir) > 0.0) {
            hn = -hn;
        }
        radiance = DirectAtHit(hit, hn, set_id, -dir, albedo) + HitEmission(id, surface, hit);
    }
    return Finite(radiance) ? clamp(radiance, vec3(0.0), vec3(Clamp())) : vec3(0.0);
}

void GlassPaint(ivec2 pixel, vec3 color) {
    imageStore(reflect_spec_out, pixel, vec4(color, 1.0));
    if ((glass_push.flags & GlassKeep) != 0u) {
        imageStore(glass_keep_out, pixel, vec4(0.0));
    }
    if ((glass_push.flags & GlassIrr) != 0u) {
        imageStore(reflect_irr_out, pixel, vec4(0.0));
    }
    imageStore(reflect_hit_out, pixel, vec4(0.0));
}

void MistKeep(ivec2 pixel, float keep) {
    if ((glass_push.flags & GlassIrr) != 0u) {
        const vec3 irr = imageLoad(reflect_irr_out, pixel).rgb;
        imageStore(reflect_irr_out, pixel, vec4(Finite(irr) ? max(irr, vec3(0.0)) * keep : vec3(0.0), 1.0));
    }
    if ((glass_push.flags & GlassKeep) != 0u) {
        imageStore(glass_keep_out, pixel, vec4(-max(keep, 1e-4)));
    }
}

void MistBase(ivec2 pixel, bool fogged, float mist_t, vec3 mist_in) {
    if (!fogged) {
        ReflectKeep(pixel);
        return;
    }
    imageStore(reflect_hit_out, pixel, vec4(0.0));
    const vec3 base = ReflectTarget(pixel) * (1.0 - clamp(glass_push.base_cut, 0.0, 1.0));
    imageStore(reflect_spec_out, pixel, vec4(clamp(base * mist_t + mist_in, vec3(0.0), vec3(ReflectMaxOutput)), 1.0));
    MistKeep(pixel, mist_t);
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const vec2 size = Size();
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    if ((glass_push.flags & GlassKeep) != 0u) {
        imageStore(glass_keep_out, pixel, vec4(1.0));
    }
    const float depth = DepthAt(pixel);
    if (depth >= 1.0 || depth < 0.0 || isnan(depth)) {
        ReflectKeep(pixel);
        return;
    }
    float roughness = 1.0;
    if ((BounceFlags() & BounceFlagG1) != 0u) {
        const float g1x = texelFetch(g1_tex, pixel, 0).x;
        roughness = isnan(g1x) ? 1.0 : clamp(1.0 - g1x, 0.0, 1.0);
    }
    const vec3 p = PixelToView(vec2(pixel), depth);
    const bool glass_candidate =
        (glass_push.flags & GlassOn) != 0u && 1.0 - roughness > glass_push.gloss;
    float t_pane = 0.0;
    Surface pane = EmptySurface();
    bool mirror = false;
    const bool glass = glass_candidate && GlassFind(p, t_pane, pane, mirror);
    if (mirror) {
        roughness = 0.0;
    }
    if (glass && (glass_push.flags & GlassDebugMask) != 0u) {
        GlassPaint(pixel, vec3(4.0, 0.0, 4.0));
        return;
    }
    if (glass_candidate && !glass && (glass_push.flags & GlassDebugCandidates) != 0u) {
        GlassPaint(pixel, vec3(0.0, 2.0, 0.0));
        return;
    }
    vec3 water_p = p;
    vec3 water_n = vec3(0.0);
    float water_depth = 0.0;
    uint water_hit =
        !glass && (glass_push.flags & WaterOn) != 0u
            ? WaterFind(p, (BounceFlags() & BounceFlagG1) == 0u || 1.0 - roughness >= WaterPuddleGloss,
                        water_p, water_n, water_depth)
            : 0u;
    // G-buffer water (a floor shader on the water list) is only wet where the game made it
    // glossy: its puddles. The rest of that floor (gloss ~0.3..0.5) is dry stone.
    if (water_hit == 2u && (BounceFlags() & BounceFlagG1) != 0u && 1.0 - roughness < WaterPuddleGloss) {
        water_hit = 1u;
    }
    const bool water = water_hit >= 2u;
    // The game's gloss ramps from dry to wet over the puddle's rim: a hard cut at
    // WaterPuddleGloss drew jagged islands of full mirror (the Hunter's Dream path).
    const float puddle_edge = glass_push.puddle_edge;
    const float puddle_w = water_hit == 2u && (BounceFlags() & BounceFlagG1) != 0u && puddle_edge > 0.0
                               ? smoothstep(WaterPuddleGloss, WaterPuddleGloss + puddle_edge, 1.0 - roughness)
                               : 1.0;
    // Sheet water is a volume: the floor shows through 1 - path / murk of the way, the rest is
    // the murky body (scattered light), and the surface mirrors only its Fresnel share. Linear
    // like the game's water layer (water colour = clamp(depth x 0.2)): shallow water is clear.
    const float clear = water_hit == 3u && glass_push.murk > 0.0 ? 1.0 - clamp(water_depth / glass_push.murk, 0.0, 1.0) : 0.0;
    // Decals on the floor (blood): no mirror or body over them, so they keep their colour
    // instead of turning to grey reflection.
    const float decal = water_hit == 3u ? WaterDecalCover(pixel) : 0.0;
    if ((glass_push.flags & WaterDebugMask) != 0u) {
        GlassPaint(pixel, water_hit == 3u ? vec3(0.5 * decal, 0.0, 0.5 * (1.0 - decal))
                          : water_hit == 2u ? vec3(0.0, 0.5, 0.5)
                                            : vec3(0.0));
        return;
    }
    float mist_t = 1.0;
    vec3 mist_in = vec3(0.0);
    if (!glass && (glass_push.flags & WaterOn) != 0u && glass_push.mist > 0.0 && glass_push.mist_height > 0.0) {
        const float set_a = (BounceFlags() & BounceFlagG3) != 0u ? texelFetch(g3_tex, pixel, 0).a : 0.0;
        MistVolume(p, water_hit == 3u, water_p, pixel, isnan(set_a) ? 0xFFFFFFFFu : uint(clamp(set_a, 0.0, 1.0) * 255.0),
                   mist_t, mist_in);
    }
    const bool fogged = mist_t < 0.9999 || dot(mist_in, vec3(1.0)) > 0.0;
    if (water) {
        roughness = glass_push.water_rough;
    }
    const bool reflect_pixel = roughness <= ReflectMaxRough() || water;
    if (!reflect_pixel && !glass) {
        MistBase(pixel, fogged, mist_t, mist_in);
        return;
    }
    vec3 n = water_hit == 3u && dot(water_n, water_n) > 0.5 ? water_n : SurfaceNormal(pixel, p);
    // A puddle's surface is mostly flat water over the cobbles: their full bump normals scattered
    // each mirror ray over a wide patch of sky, so the clouds and moon smeared into flat colour.
    if (water_hit == 2u) {
        const vec3 up = normalize(vec3(view_rows[0].y, view_rows[1].y, view_rows[2].y));
        if (dot(n, up) > PuddleFlatMin) {
            n = normalize(mix(up, n, PuddleBump));
        }
    }
    if (water) {
        n = WaterRipple(p, n, water_hit == 3u ? glass_push.ripple : glass_push.ripple * PuddleRippleScale);
    }
    // A pane seen from its back face (the far side of a glass door) is still glass: turn its
    // normal to the camera instead of dropping the pixel below.
    if (glass && dot(n, -p) < 0.0) {
        n = -n;
    }
    vec4 g3 = vec4(0.0);
    if ((BounceFlags() & BounceFlagG3) != 0u) {
        g3 = texelFetch(g3_tex, pixel, 0);
        g3 = Finite(g3.rgb) && !isnan(g3.a) ? clamp(g3, vec4(0.0), vec4(1.0)) : vec4(0.0);
    }
    const vec3 f0 = water ? vec3(water_hit == 3u ? glass_push.sheet_f0 : glass_push.water_f0)
                    : mirror ? vec3(MirrorF0)
                    : (ReflectFlags() & ReflectFlagF0) != 0u ? g3.rgb * g3.rgb
                                                              : vec3(ReflectDielectricF0);
    const uint set_id = uint(g3.a * 255.0);
    fill_set = set_id;
    const vec3 v = -normalize(p);
    const float n_dot_v = dot(n, v);
    if (n_dot_v <= 1e-4) {
        MistBase(pixel, fogged, mist_t, mist_in);
        return;
    }
    vec3 reflection = vec3(0.0);
    vec3 radiance = vec3(0.0);
    float weight = 0.0;
    float t = -1.0;
    float hit_distance = 0.0;
    bool body_lobe = false;
    float p_body = 0.0;
    float body_weight = 0.0;
    if (reflect_pixel) {
        const float alpha = max(roughness * roughness, ReflectMinAlpha);
        uint state = Hash(uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + Frame() * 26699u + 7919u);
        vec3 h = GgxHalfVector(n, alpha, state);
        vec3 l = reflect(-v, h);
        if (dot(n, l) <= 1e-4) {
            h = n;
            l = reflect(-v, n);
        }
        // Deep sheet water has a body: with probability p_body the ray scatters into the
        // hemisphere above (murky water lit by what surrounds it) instead of mirroring. The
        // body takes the (1 - F) the mirror leaves, so it shows from above, the mirror at grazing.
        if (water_hit == 3u && glass_push.body > 0.0) {
            const float cv = 1.0 - clamp(n_dot_v, 0.0, 1.0);
            const float cv2 = cv * cv;
            const float fv = f0.x + (1.0 - f0.x) * (cv2 * cv2 * cv);
            p_body = clamp(1.0 - fv, 0.1, 0.9);
            if (Random(state) < p_body) {
                body_lobe = true;
                body_weight = (1.0 - fv) * glass_push.body / p_body;
                l = CosineDirection(n, state);
                h = normalize(l + v);
            }
        }
        const float n_dot_l = max(dot(n, l), 1e-4);
        const float n_dot_h = max(dot(n, h), 1e-4);
        const float v_dot_h = max(dot(v, h), 1e-4);
        const float m = 1.0 - clamp(v_dot_h, 0.0, 1.0);
        const float m2 = m * m;
        const vec3 fresnel = f0 + (1.0 - f0) * (m2 * m2 * m);
        const float g = GgxG1(alpha, n_dot_l) * GgxG1(alpha, n_dot_v);
        weight = min(g * v_dot_h / (n_dot_v * n_dot_h), ReflectMaxWeight);
        const vec3 origin = water_p + n * (Bias() + abs(water_p.z) * 2e-4);
        uint id, primitive;
        vec2 barycentrics;
        mat3 rotation;
        uint rejected = 0u;
        t = Trace(origin, l, id, primitive, barycentrics, rotation, rejected);
        hit_distance = MissHitDistance;
        if (t < 0.0) {
            radiance = SkyRadiance(l);
        } else {
            hit_distance = t;
            const vec3 hit = origin + l * t;
            const Surface surface = HitSurface(id, primitive, barycentrics, rotation);
            // Untextured hits: traced direct light with an assumed albedo, like the GI bounce.
            const vec3 albedo = surface.valid ? surface.albedo : vec3(UnknownAlbedo);
            vec3 hn = surface.normal;
            if (dot(hn, hn) < 0.5) {
                hn = -l;
            } else if (dot(hn, l) > 0.0) {
                hn = -hn;
            }
            radiance = DirectLit(hit, hn, set_id, -l, albedo, HitMaterial(hit), BounceRays()) + HitEmission(id, surface, hit);
        }
        if (water) {
            radiance += FlameImage(origin, l, t) + MirrorHalos(origin, l, t);
        }
        if (water && glass_push.sheen > 0.0 && glass_push.sheen_far > 0.0) {
            const uint fb = set_id * 6u + 1u;
            if (fb + 1u < fog_sets.length()) {
                const vec3 fc = fog_sets[fb].rgb;
                const vec4 fd = fog_sets[fb + 1u];
                if (Finite(fc) && Finite(fd.xyz) && fd.z > 0.0) {
                    const float s0 = length(water_p);
                    const float s1 = s0 + hit_distance;
                    const float leg = max(s1 - fd.y, 0.0) - max(s0 - fd.y, 0.0);
                    const float keep = exp2(-leg * fd.z * glass_push.sheen_far);
                    radiance = mix(glass_push.sheen * max(fc, vec3(0.0)), radiance, keep);
                }
            }
        }
        radiance = Finite(radiance) ? clamp(radiance, vec3(0.0), vec3(Clamp())) : vec3(0.0);
        reflection = body_lobe ? vec3(body_weight * (1.0 - clear)) * radiance
                               : fresnel * (weight * ReflectStrength() * (water_hit == 3u ? 1.0 : 1.0 - clear) / (1.0 - p_body)) * radiance;
        // A decal (blood) shows through: no mirror or body over it.
        reflection *= (1.0 - decal) * puddle_w;
    }
    vec3 base = ReflectTarget(pixel);
    float ao = 1.0;
    if ((ReflectFlags() & ReflectFlagPreAo) != 0u) {
        const vec3 irr_after = texelFetch(reflect_irr_tex, pixel, 0).rgb;
        const vec3 irr_before = texelFetch(reflect_irr_pre_tex, pixel, 0).rgb;
        const vec3 spec_before = texelFetch(reflect_spec_pre_tex, pixel, 0).rgb;
        const float before = Finite(irr_before) ? Luma(irr_before) : 0.0;
        const float after = Finite(irr_after) ? Luma(irr_after) : 0.0;
        ao = before <= 1e-4 ? 1.0 : clamp(after / before, 0.0, 1.0);
        base = Finite(spec_before) ? max(spec_before, vec3(0.0)) : vec3(0.0);
    }
    base *= 1.0 - clamp(glass_push.base_cut, 0.0, 1.0);
    // The silvering takes the light the mirror reflects: only the rest shows the stock smudges.
    if (mirror) {
        base *= 1.0 - MirrorF0;
    }
    vec3 water_irr = vec3(0.0);
    if (water && ReflectDebug() == 0u) {
        const float c = 1.0 - clamp(n_dot_v, 0.0, 1.0);
