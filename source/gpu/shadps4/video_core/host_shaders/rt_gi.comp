    traceRayEXT(accelerationStructureEXT(tlas_frame_flags.xy), gl_RayFlagsNoneEXT, mask, 0, 1, 0,
                TlasPoint(tlas_frame_flags.xy, origin), t_min, TlasDir(tlas_frame_flags.xy, dir), t_max, 0);
    rejected += gi_payload.rejected;
    if (gi_payload.t < 0.0) {
        return -1.0;
    }
    instance_id = gi_payload.instance;
    primitive = gi_payload.primitive;
    barycentrics = gi_payload.barycentrics;
    rotation = TlasToView(tlas_frame_flags.xy, gi_payload.rotation);
    return gi_payload.t;
#endif
}
#else
// Closest alpha-tested solid hit with t in [t_min, t_max]; -1 on a miss.
float TraceSpan(vec3 origin, vec3 dir, float t_min, float t_max, uint mask, out uint instance_id,
                out uint primitive, out vec2 barycentrics, out mat3 rotation, inout uint rejected) {
    instance_id = 0xFFFFFFFFu;
    primitive = 0u;
    barycentrics = vec2(0.0);
    rotation = mat3(1.0);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_frame_flags.xy), gl_RayFlagsNoneEXT,
                          mask, TlasPoint(tlas_frame_flags.xy, origin), t_min, TlasDir(tlas_frame_flags.xy, dir), t_max);
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            const uint cand_instance = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false));
            const uint cand_prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false));
            const vec2 cand_bary = rayQueryGetIntersectionBarycentricsEXT(q, false);
            if (trace_through_glass && GlassAt(cand_instance, cand_prim, cand_bary)) {
                continue;
            }
            if (AlphaTestPasses(cand_instance, cand_prim, cand_bary)) {
                rayQueryConfirmIntersectionEXT(q);
            } else {
                ++rejected;
            }
        }
    }
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        instance_id = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true));
        primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
        barycentrics = rayQueryGetIntersectionBarycentricsEXT(q, true);
        rotation = TlasToView(tlas_frame_flags.xy, mat3(rayQueryGetIntersectionObjectToWorldEXT(q, true)));
        return rayQueryGetIntersectionTEXT(q, true);
    }
    return -1.0;
}
