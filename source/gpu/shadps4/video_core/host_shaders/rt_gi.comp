float TraceSpan(vec3 origin, vec3 dir, float t_min, float t_max, uint mask, out uint instance_id,
                out uint primitive, out vec2 barycentrics, out mat3 rotation, inout uint rejected) {
    instance_id = 0xFFFFFFFFu;
    primitive = 0u;
    barycentrics = vec2(0.0);
    rotation = mat3(1.0);
    gi_payload.flags = trace_through_glass ? GiPayloadThroughGlass : 0u;
    gi_payload.rejected = 0u;
    gi_payload.t = -1.0;
#ifdef RT_GI_SER
    hitObjectNV hit;
    hitObjectTraceRayNV(hit, accelerationStructureEXT(tlas_frame_flags.xy), gl_RayFlagsNoneEXT,
                        mask, 0, 1, 0, TlasPoint(tlas_frame_flags.xy, origin), t_min,
                        TlasDir(tlas_frame_flags.xy, dir), t_max, 0);
    rejected += gi_payload.rejected;
    const bool is_hit = hitObjectIsHitNV(hit);
    const uint hint = is_hit ? (uint(hitObjectGetInstanceCustomIndexNV(hit)) & 0x7FFFu) | 0x8000u
                             : 0u;
    reorderThreadNV(hit, hint, GiReorderBits);
    if (!is_hit) {
        return -1.0;
    }
    hitObjectGetAttributesNV(hit, 0);
    instance_id = uint(hitObjectGetInstanceCustomIndexNV(hit));
    primitive = uint(hitObjectGetPrimitiveIndexNV(hit));
    barycentrics = gi_hit_attribs;
    rotation = TlasToView(tlas_frame_flags.xy, mat3(hitObjectGetObjectToWorldNV(hit)));
    return hitObjectGetRayTMaxNV(hit);
