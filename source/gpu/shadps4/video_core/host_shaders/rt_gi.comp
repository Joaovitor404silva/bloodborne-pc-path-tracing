layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer TlasSpace {
    vec4 tlas_rows[3];
};

TlasSpace TlasSpaceOf(uvec2 tlas) {
    return TlasSpace(uvec2(tlas.x - 256u, tlas.y - (tlas.x < 256u ? 1u : 0u)));
}

vec3 TlasPoint(uvec2 tlas, vec3 p) {
    TlasSpace s = TlasSpaceOf(tlas);
    return vec3(dot(s.tlas_rows[0], vec4(p, 1.0)), dot(s.tlas_rows[1], vec4(p, 1.0)),
                dot(s.tlas_rows[2], vec4(p, 1.0)));
}

vec3 TlasDir(uvec2 tlas, vec3 d) {
    TlasSpace s = TlasSpaceOf(tlas);
    return vec3(dot(s.tlas_rows[0].xyz, d), dot(s.tlas_rows[1].xyz, d), dot(s.tlas_rows[2].xyz, d));
}

mat3 TlasToView(uvec2 tlas, mat3 m) {
    TlasSpace s = TlasSpaceOf(tlas);
    return mat3(s.tlas_rows[0].xyz, s.tlas_rows[1].xyz, s.tlas_rows[2].xyz) * m;
}

