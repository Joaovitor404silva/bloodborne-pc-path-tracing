bool PortalPane(uint id) {
    return (BounceFlags() & BounceFlagPortals) != 0u && id < surfaces.length() &&
           (surfaces[id].flags & SurfacePortalPane) != 0u;
}

float Trace(vec3 origin, vec3 dir, out uint instance_id, out uint primitive, out vec2 barycentrics,
            out mat3 rotation, inout uint rejected, float t_min) {
    trace_through_glass = true;
    const float t = TraceSpan(origin, dir, t_min, trace_cap, MaskSolid, instance_id, primitive,
                              barycentrics, rotation, rejected);
    trace_through_glass = false;
    return t;
}

float Trace(vec3 origin, vec3 dir, out uint instance_id, out uint primitive, out vec2 barycentrics,
            out mat3 rotation, inout uint rejected) {
    return Trace(origin, dir, instance_id, primitive, barycentrics, rotation, rejected, 0.0);
}

vec3 WorldUp() {
    return normalize(vec3(view_rows[0].y, view_rows[1].y, view_rows[2].y));
}

float WaterSpan(vec3 origin, vec3 dir, float t_hit, uint hit_id) {
    if ((BounceFlags() & BounceFlagWater) == 0u || dot(dir, WorldUp()) >= 0.0) {
        return -1.0;
    }
    if (t_hit >= 0.0 && hit_id < surfaces.length() && (surfaces[hit_id].flags & SurfaceWater) != 0u) {
        return t_hit;
    }
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_frame_flags.xy), gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                          MaskWater, TlasPoint(tlas_frame_flags.xy, origin), 0.0,
                          TlasDir(tlas_frame_flags.xy, dir), t_hit >= 0.0 ? t_hit : trace_cap);
    while (rayQueryProceedEXT(q)) {
    }
    if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
        return -1.0;
    }
    return rayQueryGetIntersectionTEXT(q, true);
}

// Transmittance over [t_min, t_max]; mask 0x03 leaves the portal panes out.
float SegmentTransmittance(vec3 origin, vec3 dir, float t_min, float t_max) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_frame_flags.xy),
                          gl_RayFlagsTerminateOnFirstHitEXT, 0x03u, TlasPoint(tlas_frame_flags.xy, origin), t_min, TlasDir(tlas_frame_flags.xy, dir), t_max);
    float t = 1.0;
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
            continue;
        }
        const uint instance = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false));
        const uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false));
        const vec2 b = rayQueryGetIntersectionBarycentricsEXT(q, false);
        if (GlassAt(instance, primitive, b)) {
            t *= GlassTransmit;
        } else if (instance < surfaces.length() && (surfaces[instance].flags & SurfaceBlended) != 0u) {
            t *= 1.0 - clamp(SmokeAlpha(instance, primitive, b) * SmokeGiOpacity, 0.0, 1.0);
            if (t < 0.02) {
                rayQueryConfirmIntersectionEXT(q);
            }
        } else if (AlphaTestPasses(instance, primitive, b)) {
            rayQueryConfirmIntersectionEXT(q);
        }
    }
    return rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT
               ? 0.0
               : t;
}

// Painted windows: see rt_direct.comp Transmittance.
float Transmittance(vec3 origin, vec3 dir, float t_max) {
    if ((BounceFlags() & BounceFlagPortals) != 0u) {
        rayQueryEXT p;
        rayQueryInitializeEXT(p, accelerationStructureEXT(tlas_frame_flags.xy), gl_RayFlagsOpaqueEXT,
                              MaskPortal, TlasPoint(tlas_frame_flags.xy, origin), 0.0, TlasDir(tlas_frame_flags.xy, dir), t_max);
        while (rayQueryProceedEXT(p)) {
        }
        if (rayQueryGetIntersectionTypeEXT(p, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            const float t_pane = rayQueryGetIntersectionTEXT(p, true);
            const float t = SegmentTransmittance(origin, dir, 0.0, t_pane);
            return t > 0.0 && t_pane + PortalWall < t_max
                       ? t * SegmentTransmittance(origin, dir, t_pane + PortalWall, t_max)
                       : t;
        }
    }
    return SegmentTransmittance(origin, dir, 0.0, t_max);
}

bool Finite(vec3 v) {
    return !(any(isnan(v)) || any(isinf(v)));
}

vec3 Radiance(ivec2 pixel) {
    vec3 c = texelFetch(scene_tex, pixel, 0).rgb;
    if (!Finite(c)) {
        return vec3(0.0);
    }
    return clamp(c, vec3(0.0), vec3(Clamp()));
}

uint MaterialEncode(float radiance) {
    const float v = isnan(radiance) ? 0.0 : clamp(radiance, 0.0, MaterialMaxRadiance);
    return uint(v * float(MaterialScale) + 0.5);
}

void MaterialAccumulate(uint id, vec3 radiance) {
    atomicAdd(accum[id].x, MaterialEncode(radiance.x));
    atomicAdd(accum[id].y, MaterialEncode(radiance.y));
    atomicAdd(accum[id].z, MaterialEncode(radiance.z));
    atomicAdd(accum[id].w, 1u);
}

float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 CachedRadiance(uint id, Surface surface, out uint source) {
    if (id < material.length()) {
        const vec4 m = material[id];
        if (m.w > 0.0 && Finite(m.rgb)) {
            source = SourceMaterial;
            const vec3 cached = clamp(m.rgb, vec3(0.0), vec3(Clamp()));
            if (surface.valid) {
                return clamp(surface.albedo * (Luma(cached) / max(Luma(surface.albedo), 0.05)),
                             vec3(0.0), vec3(Clamp()));
            }
            return cached;
        }
    }
    source = SourceSky;
    if (surface.valid) {
        return surface.albedo * Sky();
    }
    return vec3(Sky());
}

const uint BounceFlagEmissive = 32u;
const uint SkyProbeSize = 32u;

uint EmissiveBase() { return SkySlot() + 1u; }
uint SkyProbeBase() { return 2u * SkySlot() + 1u; }

bool LearnSample() {
#ifdef RT_LIGHT_VIS
    return false; // the light visibility pass only reads the material and emissive caches
#else
    const uvec2 p = GI_INVOCATION.xy;
    return ((p.x * 7u + p.y * 13u + Frame()) & MaterialSampleMask) == 0u;
#endif
}

vec3 WorldDir(vec3 v) {
    return view_rows[0].xyz * v.x + view_rows[1].xyz * v.y + view_rows[2].xyz * v.z;
}

vec2 OctEncode(vec3 d) {
    const float l1 = abs(d.x) + abs(d.y) + abs(d.z);
    if (!(l1 > 0.0)) {
        return vec2(0.5);
    }
    vec2 p = d.xy / l1;
    if (d.z < 0.0) {
        p = (1.0 - abs(p.yx)) * vec2(p.x >= 0.0 ? 1.0 : -1.0, p.y >= 0.0 ? 1.0 : -1.0);
    }
    return p * 0.5 + 0.5;
}

uint SkyProbeCell(vec3 world_dir) {
    const ivec2 c = clamp(ivec2(OctEncode(world_dir) * float(SkyProbeSize)), ivec2(0),
                          ivec2(int(SkyProbeSize) - 1));
    return uint(c.y) * SkyProbeSize + uint(c.x);
}

void SkyLearn(ivec2 pixel) {
    const vec3 c = Radiance(pixel);
    MaterialAccumulate(SkySlot(), c);
    const vec2 uv = (vec2(pixel) + 0.5 - Jitter()) / Size();
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    const vec3 v = vec3(ndc.x / proj.x, ndc.y / proj.y, 1.0);
    const vec3 w = WorldDir(v);
    if (!Finite(w) || dot(w, w) <= 0.0) {
        return;
    }
    const uint slot = SkyProbeBase() + SkyProbeCell(normalize(w));
    if (slot < accum.length()) {
        MaterialAccumulate(slot, c);
    }
}

bool SkyProbe(vec3 dir, out vec3 radiance) {
    radiance = vec3(0.0);
    const vec3 w = WorldDir(dir);
    if (!Finite(w) || dot(w, w) <= 0.0) {
        return false;
    }
    const vec2 f = OctEncode(normalize(w)) * float(SkyProbeSize) - 0.5;
    const ivec2 i0 = ivec2(floor(f));
    const vec2 t = f - vec2(i0);
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int k = 0; k < 4; ++k) {
        const ivec2 o = ivec2(k & 1, k >> 1);
        const ivec2 c = clamp(i0 + o, ivec2(0), ivec2(int(SkyProbeSize) - 1));
        const uint slot = SkyProbeBase() + uint(c.y) * SkyProbeSize + uint(c.x);
        if (slot >= material.length()) {
            continue;
        }
        const vec4 m = material[slot];
        if (m.w <= 0.0 || !Finite(m.rgb)) {
            continue;
        }
        const float wt = (o.x == 1 ? t.x : 1.0 - t.x) * (o.y == 1 ? t.y : 1.0 - t.y);
        sum += wt * clamp(m.rgb, vec3(0.0), vec3(Clamp()));
        weight += wt;
    }
    if (weight <= 1e-3) {
        return false;
    }
    radiance = sum / weight;
    return true;
}

#ifdef RT_REFLECT
// Dome texture v against elevation, as in rt_sky.comp (read from the dome mesh rings).
const int DomeRows = 11;
const float DomeRowElev[DomeRows] = float[](-2.9, 1.8, 6.8, 12.4, 19.2, 28.3, 41.4, 56.0, 80.8,
                                            85.8, 90.0);
const float DomeRowV[DomeRows] = float[](2044.0, 1780.0, 1501.0, 1211.0, 892.0, 572.0, 337.0,
                                         176.0, 79.0, 14.0, 0.0);

float DomeElevationToV(float elev) {
    if (elev <= DomeRowElev[0]) {
        return DomeRowV[0];
    }
    for (int i = 1; i < DomeRows; ++i) {
        if (elev <= DomeRowElev[i]) {
            const float t = (elev - DomeRowElev[i - 1]) / (DomeRowElev[i] - DomeRowElev[i - 1]);
            return mix(DomeRowV[i - 1], DomeRowV[i], t);
        }
    }
    return 0.0;
}

/// Mip level for mirror rays: ripples spread neighbouring pixels over many texels, and lod 0
// aliased the dome into grain.
const float DomeMirrorLod = 1.0;

const uint SkyImageSize = 1024u; // rt_gi.h SkyImageSize

// The sky image the sky pass learned from the screen (clouds included), bilinear over the
// cells seen so far; false where the sky was never on screen.
bool SkyImage(vec3 w, out vec3 radiance) {
    radiance = vec3(0.0);
    const uint base = SkyProbeBase() + SkyProbeSize * SkyProbeSize + 2u;
    const vec2 f = OctEncode(w) * float(SkyImageSize) - 0.5;
    const ivec2 i0 = ivec2(floor(f));
    const vec2 t = f - vec2(i0);
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int k = 0; k < 4; ++k) {
        const ivec2 o = ivec2(k & 1, k >> 1);
        const ivec2 c = clamp(i0 + o, ivec2(0), ivec2(int(SkyImageSize) - 1));
        const uint slot = base + uint(c.y) * SkyImageSize + uint(c.x);
        if (slot >= material.length()) {
            continue;
        }
        const vec4 m = material[slot];
        if (m.w <= 0.0 || !Finite(m.rgb)) {
            continue;
        }
        const float wt = (o.x == 1 ? t.x : 1.0 - t.x) * (o.y == 1 ? t.y : 1.0 - t.y);
        sum += wt * m.rgb;
        weight += wt;
    }
    if (weight < 0.25) {
        return false;
    }
    radiance = clamp(sum / weight, vec3(0.0), vec3(Clamp()));
    return true;
}

// The learned sky image, else dome texture x the sky pass's fitted gain.
bool DomeSky(vec3 dir, out vec3 radiance) {
    radiance = vec3(0.0);
    if ((glass_push.flags & ReflectSkyDome) == 0u) {
        return false;
    }
    {
        const vec3 wi = WorldDir(dir);
        if (Finite(wi) && dot(wi, wi) > 0.0 && SkyImage(normalize(wi), radiance)) {
            return true;
        }
    }
    const uint gain_slot = SkyProbeBase() + SkyProbeSize * SkyProbeSize;
    if (gain_slot + 1u >= material.length()) {
        return false;
    }
    const vec4 g = material[gain_slot];
    const vec4 map = material[gain_slot + 1u];
    if (!(g.w > 0.0) || !(map.w > 0.0) || !Finite(g.rgb)) {
        return false;
    }
    vec3 w = WorldDir(dir);
    if (!Finite(w) || dot(w, w) <= 0.0) {
        return false;
    }
    w = normalize(w);
    const float elev = degrees(asin(clamp(w.y, -1.0, 1.0)));
    const float phi = atan(w.z, w.x) * 0.15915494; // 1 / (2 pi)
    vec2 uv = vec2((map.x + phi) * map.y, DomeElevationToV(elev) / map.z);
    uv.y = clamp(uv.y, 0.5 / 512.0, 1.0 - 0.5 / 512.0);
    const vec3 c = textureLod(sky_dome_tex, uv, DomeMirrorLod).rgb;
    if (!Finite(c)) {
        return false;
    }
    radiance = clamp(max(c, vec3(0.0)) * g.rgb, vec3(0.0), vec3(Clamp()));
    return true;
}
#endif

float FillSkyGain() { return strength_bias.w; }

// The game's directional lights 3 and 4 (half-Lambert squared, unshadowed in the stock shader)
// are its sky light: on the Cathedral Ward bridge they are as bright as the moon and light the
// snow from behind the camera, while the painted night dome is nearly black. Path-traced light
// only (37c9e7c) dropped them, so open ground under a full moon came out ~6x darker than stock.
// Here they come back as sky radiance on GI misses (world set, rt_world_set.comp), so geometry
// occludes them. 24/17 makes an unoccluded surface facing the light get the stock value:
// the cosine-weighted mean of ((1 + mu) / 2)^2 over that hemisphere is 17/24.
// BB_RT_GI_FILL_SKY scales it (0 = off); the reflection pass passes 0.
// The primary pixel's own directional set (GBuffer3 alpha), for FillSky; ~0u = none.
uint fill_set = 0xFFFFFFFFu;

// rt_direct.comp MoonSet: the pixel's own set when its light 1 points where the world set's
// does, so each material keeps the game's moon colour and it does not follow the camera; else
// the world set. ~0u when neither is valid.
uint MoonSet(uint own) {
    const uint count = DirSetCount();
    const uint world = WorldSet();
    const uint w = world != 0u && world <= count ? world - 1u : 0xFFFFFFFFu;
    if (own >= count) {
        return w;
    }
    if (w == 0xFFFFFFFFu || w == own) {
        return own;
    }
    const vec3 c = sets[own * 18u + 4u].xyz;
    const vec3 d_own = sets[own * 18u].xyz;
    const vec3 d_world = sets[w * 18u].xyz;
    const bool aligned = dot(c, c) > 0.0 && dot(d_own, d_own) > 0.0 && dot(d_world, d_world) > 0.0 &&
                         dot(normalize(d_own), normalize(d_world)) > 0.9999;
    return aligned ? own : w;
}

vec3 FillSky(vec3 dir) {
    const float gain = FillSkyGain();
    if (!(gain > 0.0) || (BounceFlags() & BounceFlagDirSets) == 0u) {
        return vec3(0.0);
    }
    const uint set = MoonSet(fill_set);
    if (set >= DirSetCount()) {
        return vec3(0.0);
    }
    const uint base = set * 18u;
    const uvec2 extra = floatBitsToUint(sets[base + 16u].xy);
    vec3 r = vec3(0.0);
    for (uint k = 0u; k < 2u; ++k) {
        if ((k == 0u ? extra.x : extra.y) == 0u) {
            continue;
        }
        const vec3 d = sets[base + 2u + k].xyz;
        if (!(dot(d, d) > 0.0)) {
            continue;
        }
        const vec3 L = normalize(vec3(dot(view_rows[0].xyz, d), dot(view_rows[1].xyz, d),
                                      dot(view_rows[2].xyz, d)));
        const float h = 0.5 * dot(dir, L) + 0.5;
        r += max(sets[base + 6u + k].xyz, vec3(0.0)) * (h * h);
    }
    r *= gain * (24.0 / 17.0);
    return Finite(r) ? r : vec3(0.0);
}

vec3 SkyLookup(vec3 dir);

vec3 SkyRadiance(vec3 dir) {
    return SkyLookup(dir) + FillSky(dir);
}

vec3 SkyLookup(vec3 dir) {
#ifdef RT_REFLECT
    vec3 dome;
    if (DomeSky(dir, dome)) {
        return dome;
    }
#endif
    const vec2 pixel = ViewToPixel(dir * 1e5, proj, Jitter());
    const ivec2 ip = ivec2(floor(pixel + 0.5));
    if ((Flags() & (FlagNoScreen | FlagSkyDome)) == 0u && dir.z > 1e-4 &&
        all(greaterThanEqual(ip, ivec2(0))) &&
        all(lessThan(ip, ivec2(Size()))) && DepthAt(ip) >= 1.0) {
        return Radiance(ip);
    }
    vec3 probe;
    if (SkyProbe(dir, probe)) {
        return probe;
    }
    const uint slot = SkySlot();
    if (slot < material.length()) {
        const vec4 m = material[slot];
        if (m.w > 0.0 && Finite(m.rgb)) {
            return clamp(m.rgb, vec3(0.0), vec3(Clamp()));
        }
    }
    return vec3(Sky());
}

vec3 Emission(uint id, Surface surface, vec3 hit) {
    if ((BounceFlags() & BounceFlagEmissive) != 0u) {
        if (id >= SkySlot()) {
            return vec3(0.0);
        }
        const uint slot = EmissiveBase() + id;
        const ivec2 ip = ivec2(floor(ViewToPixel(hit, proj, Jitter()) + 0.5));
        if (hit.z > 1e-4 && all(greaterThanEqual(ip, ivec2(0))) && all(lessThan(ip, ivec2(Size()))) &&
            abs(ViewZ(DepthAt(ip)) - hit.z) <= 0.03 * hit.z + 0.05) {
            const vec3 e = texelFetch(emissive_tex, ip, 0).rgb;
            const vec3 c = Finite(e) ? clamp(e, vec3(0.0), vec3(Clamp())) : vec3(0.0);
            if (LearnSample() && slot < accum.length()) {
                MaterialAccumulate(slot, c);
            }
            return c;
        }
        if (slot < material.length()) {
            const vec4 m = material[slot];
            if (m.w > 0.0 && Finite(m.rgb)) {
                return clamp(m.rgb, vec3(0.0), vec3(Clamp()));
            }
        }
        return vec3(0.0);
    }
    const float threshold = EmissiveLuma();
    if (threshold <= 0.0 || id >= SkySlot() || id >= material.length()) {
        return vec3(0.0);
    }
    const vec4 m = material[id];
    if (m.w <= 0.0 || !Finite(m.rgb)) {
        return vec3(0.0);
    }
    const vec3 cached = clamp(m.rgb, vec3(0.0), vec3(Clamp()));
    const float luma = Luma(cached);
    if (luma <= threshold) {
        return vec3(0.0);
    }
    if (surface.valid) {
        return clamp(surface.albedo * (luma / max(Luma(surface.albedo), 0.05)), vec3(0.0),
                     vec3(Clamp()));
    }
    return cached;
}

// Emission at a traced hit. Untextured hits only take the emissive target: the cached-luma
// fallback is the mesh's mean screen colour, which already holds lighting.
vec3 HitEmission(uint id, Surface surface, vec3 hit) {
    if (!surface.valid && (BounceFlags() & BounceFlagEmissive) == 0u) {
        return vec3(0.0);
    }
    return Emission(id, surface, hit);
}

vec3 HitRadiance(vec3 hit, bool missed, vec3 dir, uint id, Surface surface, bool sample_material,
                 out uint source) {
    const vec2 size = Size();
    source = SourceMiss;
    if (missed) {
        return SkyRadiance(dir);
    }
    const vec2 pixel = ViewToPixel(hit, proj, Jitter());
    const ivec2 ip = ivec2(floor(pixel + 0.5));
    if ((Flags() & FlagNoScreen) != 0u || hit.z <= 1e-4 || any(lessThan(ip, ivec2(0))) ||
        any(greaterThanEqual(ip, ivec2(size)))) {
        return CachedRadiance(id, surface, source);
    }
    const float screen_z = ViewZ(DepthAt(ip));
    if (abs(screen_z - hit.z) <= 0.03 * hit.z + 0.05) {
        source = SourceScreen;
        const vec3 c = Radiance(ip);
        if (sample_material && id < accum.length()) {
            MaterialAccumulate(id, c);
        }
        return c;
    }
    return CachedRadiance(id, surface, source);
}

const float HitDefaultF0 = 0.04;
const float HitDefaultRoughness = 0.6;
const float HitMinAlpha = 0.02;
const float HitSpecMax = 16.0;

vec4 HitMaterial(vec3 p) {
    vec4 m = vec4(vec3(HitDefaultF0), HitDefaultRoughness);
    const vec2 pixel = ViewToPixel(p, proj, Jitter());
    const ivec2 ip = ivec2(floor(pixel + 0.5));
    if ((Flags() & FlagNoScreen) != 0u || p.z <= 1e-4 || any(lessThan(ip, ivec2(0))) ||
        any(greaterThanEqual(ip, ivec2(Size())))) {
        return m;
    }
    const float screen_z = ViewZ(DepthAt(ip));
    if (abs(screen_z - p.z) > 0.03 * p.z + 0.05) {
        return m;
    }
    if ((BounceFlags() & BounceFlagG3) != 0u) {
        const vec3 g3 = texelFetch(g3_tex, ip, 0).rgb;
        if (Finite(g3)) {
            const vec3 c = clamp(g3, vec3(0.0), vec3(1.0));
            m.rgb = c * c;
        }
    }
    if ((BounceFlags() & BounceFlagG1) != 0u) {
        const float g1x = texelFetch(g1_tex, ip, 0).x;
        if (!isnan(g1x)) {
            m.a = clamp(1.0 - g1x, 0.0, 1.0);
        }
    }
    return m;
}

float HitSpecG1(float alpha, float c) {
    const float a2 = alpha * alpha;
    return 2.0 * c / (c + sqrt(a2 + (1.0 - a2) * c * c));
}

vec3 HitSpecular(vec4 material, vec3 n, vec3 v, vec3 l) {
    const float nl = dot(n, l), nv = dot(n, v);
    if (nl <= 0.0 || nv <= 0.0) {
        return vec3(0.0);
    }
    const vec3 h = normalize(l + v);
    const float nh = dot(n, h);
    if (nh <= 0.0) {
        return vec3(0.0);
    }
    const float r = clamp(material.a, 0.0, 1.0);
    const float alpha = max(r * r, HitMinAlpha);
    const float a2 = alpha * alpha;
    const float dd = nh * nh * (a2 - 1.0) + 1.0;
    const float d = a2 / (3.14159265 * dd * dd);
    const float m = 1.0 - clamp(dot(v, h), 0.0, 1.0);
    const float m2 = m * m;
    const vec3 f = material.rgb + (1.0 - material.rgb) * (m2 * m2 * m);
    const float g = HitSpecG1(alpha, nl) * HitSpecG1(alpha, nv);
    return min(f * (3.14159265 * d * g / (4.0 * nl * nv)), vec3(HitSpecMax));
}

void LightCell(vec3 p, out uint first, out uint last, out uint entries, out bool grid) {
    first = 0u;
    last = min(LightCount(), MaxGiLights);
    entries = 0u;
    grid = light_grid[7] != 0u;
    if (grid) {
        const vec3 grid_origin = uintBitsToFloat(uvec3(light_grid[0], light_grid[1], light_grid[2]));
        const float inv_cell = uintBitsToFloat(light_grid[3]);
        const uvec3 dims = uvec3(light_grid[4], light_grid[5], light_grid[6]);
        const vec3 f = clamp(floor((p - grid_origin) * inv_cell), vec3(0.0), vec3(dims - 1u));
        const uvec3 c = uvec3(f);
        const uint cells = dims.x * dims.y * dims.z;
        const uint cell = min((c.z * dims.y + c.y) * dims.x + c.x, cells - 1u);
        first = light_grid[8u + cell];
        last = light_grid[9u + cell];
        entries = 9u + cells;
    }
}

vec3 DirectLit(vec3 p, vec3 n, uint set_id, vec3 v, vec3 albedo, vec4 material, uint rays) {
    vec3 result = vec3(0.0);
    uint traced = 0u;
    const vec3 origin = p + n * (Bias() + abs(p.z) * 2e-4);
    if ((BounceFlags() & BounceFlagLights) != 0u) {
        const uint count = min(LightCount(), MaxGiLights);
        uint first, last, entries;
        bool grid;
        LightCell(p, first, last, entries, grid);
        for (uint k = first; k < last; ++k) {
            const uint i = grid ? light_grid[entries + k] : k;
            if (i >= count) {
                continue;
            }
            const DirectLight l = lights[i];
            const vec3 d = l.pos_inv_r2.xyz - p;
            const float d2 = dot(d, d);
            const float inv_r2 = l.pos_inv_r2.w;
            if (d2 <= 1e-8 || d2 * inv_r2 >= 1.0) {
                continue;
            }
            float cone = 1.0;
            float atten = max(0.0, 1.0 / d2 - inv_r2);
            if (l.spec_kind.w > 0.5) {
                const vec4 hp = vec4(p, 1.0);
                const vec4 q = vec4(dot(l.cone[0], hp), dot(l.cone[1], hp), dot(l.cone[2], hp),
                                    dot(l.cone[3], hp));
                if (q.z <= 0.0 || q.w == 0.0) {
                    continue;
                }
                const vec2 xy = q.xy / q.w;
                const float disc = clamp(1.0 - dot(xy, xy), 0.0, 1.0);
                if (l.spec_kind.w < 1.5) {
                    cone = disc;
                } else {
                    const float axial = clamp(1.0 - q.w / l.wrap_r_flag.z, 0.0, 1.0);
                    cone = disc * disc * axial * axial;
                    atten = 1.0;
                }
                if (cone <= 0.0) {
                    continue;
                }
            }
            const float dist = sqrt(d2);
            const float nl = clamp(dot(n, d / dist), 0.0, 1.0);
            if (nl <= 0.0) {
                continue;
            }
            if ((uint(l.wrap_r_flag.w + 0.5) & 1u) != 0u) {
                const float legacy_f = 1.0 - sqrt(clamp(d2 * inv_r2, 0.0, 1.0));
                atten = legacy_f * legacy_f;
            }
            if ((uint(l.wrap_r_flag.w + 0.5) & 4u) != 0u) {
                const float s2 = l.wrap_r_flag.z;
                atten = max(0.0, s2 / (d2 + s2) - s2 / (1.0 / inv_r2 + s2)) *
                        HousingFade(uint(l.wrap_r_flag.w + 0.5), d2);
            }
            const vec3 c = l.color_sp.rgb * (nl * atten * cone) *
                           (albedo + HitSpecular(material, n, v, d / dist));
            if (dot(c, vec3(1.0)) <= 0.0) {
                continue;
            }
            float vis = 1.0;
            if (traced < rays) {
                ++traced;
                const vec3 ray = l.pos_inv_r2.xyz - origin;
                const float ray_len = length(ray);
                if (ray_len > 1e-3) {
                    vis = Transmittance(origin, ray / ray_len, max(ray_len - BounceGap(), 1e-3));
                }
            }
            result += c * vis;
        }
    }
    if ((BounceFlags() & BounceFlagDirSets) != 0u && set_id < DirSetCount()) {
        // The same set the direct pass shades this pixel with (MoonSet), so bounce light has the
        // same moon.
        const uint base = MoonSet(set_id) * 18u;
        const vec4 d1 = sets[base];
        const vec3 c1 = sets[base + 4u].xyz;
        const vec3 L1 = normalize(vec3(dot(view_rows[0].xyz, d1.xyz), dot(view_rows[1].xyz, d1.xyz),
                                       dot(view_rows[2].xyz, d1.xyz)));
        const float nl1 = clamp(dot(n, L1), 0.0, 1.0);
        float sun_vis = 1.0;
        if (nl1 > 0.0 && dot(c1, c1) > 0.0) {
            sun_vis = Transmittance(origin, L1, 1.0e4);
        }
        result += c1 * nl1 * sun_vis * (albedo + HitSpecular(material, n, v, L1));
    }
    return Finite(result) ? result : vec3(0.0);
}

vec3 DirectAtHit(vec3 p, vec3 n, uint set_id, vec3 v, vec3 albedo) {
    return DirectLit(p, n, set_id, v, albedo, HitMaterial(p), BounceRays());
}

vec3 SourceColor(uint source) {
    return source == SourceScreen ? vec3(0.0, 1.0, 0.0)
         : source == SourceTraced ? vec3(1.0, 1.0, 0.0)
         : source == SourceUnknown ? vec3(1.0, 0.0, 1.0)
         : source == SourceSharc ? vec3(0.0, 1.0, 1.0)
         : source == SourceMaterial ? vec3(0.0, 0.3, 1.0)
         : source == SourceSky ? vec3(1.0, 0.0, 0.0) : vec3(0.25);
}

vec3 CosineDirection(vec3 n, inout uint state) {
    const vec3 helper = abs(n.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    const vec3 tangent = normalize(cross(helper, n));
    const vec3 bitangent = cross(n, tangent);
    const float u1 = Random(state);
    const float u2 = Random(state);
    const float r = sqrt(u1);
    const float phi = 6.28318530718 * u2;
    const vec3 local = vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u1)));
    return tangent * local.x + bitangent * local.y + n * local.z;
}

void WriteAux(ivec2 pixel, vec3 albedo, vec3 spec, vec3 n, float roughness, float hit_distance) {
    imageStore(aux_albedo_out, pixel, vec4(albedo, 1.0));
    imageStore(aux_spec_out, pixel, vec4(spec, 1.0));
    imageStore(aux_normal_out, pixel, vec4(n, roughness));
    imageStore(aux_hit_out, pixel, vec4(hit_distance, 0.0, 0.0, 0.0));
}

#if defined(RT_LIGHT_VIS)
// Fill-light visibility (BB_RT_FILL_VIS): one workgroup per light, fixed Fibonacci-sphere rays
// from the light position, so the result is deterministic and noise-free. A ray that reaches no
// solid surface counts as sky, weighted by the same blended (glass, smoke) attenuation as the
// moon's shadow rays; shadow-only kept casters block it like they block the moon.
// Emitter evidence, all reported to the host which decides:
// - emission (Emission()) at a solid or blended hit within emit_dist;
// - enclosure: the fraction of rays that meet solid or blended geometry within emit_dist. A light
//   inside a fixture (lantern housing, glass panes, candle) is mostly enclosed; a fill light near
//   a wall is not (a wall 0.4 m away covers ~17% of the sphere within 0.6 m);
// - screen: whether the light position is on screen and not hidden (then this frame's TLAS holds
//   the geometry drawn there), and the emissive G-buffer target around it.
const uint MaxLightVis = 64u; // Rt::FillVisBatch
const uint VisOutputs = 3u;   // Rt::FillVisOutputs
layout(binding = 28, std430) buffer LightVis {
    vec4 vis_in[MaxLightVis]; // xyz: light position in view space
    // [0] sky fraction, emissive ray fraction, max emission luma, nearest solid hit
    // [1] enclosed ray fraction, blended-within-reach ray fraction, nearest blended hit,
    //     max screen emissive luma near the light
    // [2] on screen and not hidden (0/1), scene depth minus light depth at its pixel,
//     enclosed fraction of the upward rays (world y > 0.5): a lamp's cap vs a fire's open top
    vec4 vis_out[MaxLightVis * VisOutputs];
};
layout(push_constant) uniform VisPush {
    uint vis_count;
    uint vis_rays;
    float vis_offset;
    float vis_emit_dist;
    float vis_emit_luma;
    float vis_smoke;
};
const uint VisThreads = 64u; // local_size 8x8
const uint VisScreenTaps = 25u; // 5x5 window
const uint VisScreenCentre = 12u;
const float VisScreenRadius = 0.3; // metres around the light
shared vec4 vis_a[VisThreads];
shared vec4 vis_b[VisThreads];
shared vec2 vis_screen;
shared vec2 vis_up[VisThreads];

vec3 FibonacciDir(uint i, uint n) {
    const float z = 1.0 - (2.0 * float(i) + 1.0) / float(n);
    const float r = sqrt(max(0.0, 1.0 - z * z));
    const float phi = float(i) * 2.39996322973;
    return vec3(r * cos(phi), r * sin(phi), z);
}

// Transmittance of a ray that reached no solid surface: blended surfaces attenuate it like the
// moon's shadow rays (rt_direct.comp Transmittance, alpha x BB_RT_FX_SMOKE_OPACITY), kept
// shadow-only casters block it.
float VisSkyTransmittance(vec3 origin, vec3 dir) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_frame_flags.xy),
                          gl_RayFlagsTerminateOnFirstHitEXT, 0x6Fu & ~MaskSolid, TlasPoint(tlas_frame_flags.xy, origin), 0.0, TlasDir(tlas_frame_flags.xy, dir),
                          1e6);
    float t = 1.0;
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
            continue;
        }
        const uint instance = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false));
        const uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false));
        const vec2 b = rayQueryGetIntersectionBarycentricsEXT(q, false);
        if (instance < surfaces.length() && (surfaces[instance].flags & SurfaceBlended) != 0u) {
            t *= 1.0 - clamp(SmokeAlpha(instance, primitive, b) * vis_smoke, 0.0, 1.0);
            if (t < 0.02) {
                rayQueryConfirmIntersectionEXT(q);
            }
        } else if (AlphaTestPasses(instance, primitive, b)) {
            rayQueryConfirmIntersectionEXT(q);
        }
    }
    return rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT
               ? 0.0
               : t;
}

// Closest blended surface (glass, sprites in the TLAS) up to t_max, whatever its alpha: thin
// lantern panes count as part of the fixture.
float VisBlendedHit(vec3 origin, vec3 dir, float t_max, out uint instance_id, out uint primitive,
                    out vec2 barycentrics, out mat3 rotation) {
    instance_id = 0xFFFFFFFFu;
    primitive = 0u;
    barycentrics = vec2(0.0);
    rotation = mat3(1.0);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_frame_flags.xy), gl_RayFlagsNoneEXT,
                          0x02u, TlasPoint(tlas_frame_flags.xy, origin), 0.0, TlasDir(tlas_frame_flags.xy, dir), t_max);
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            rayQueryConfirmIntersectionEXT(q);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        instance_id = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true));
        primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
        barycentrics = rayQueryGetIntersectionBarycentricsEXT(q, true);
        rotation = TlasToView(tlas_frame_flags.xy, mat3(rayQueryGetIntersectionObjectToWorldEXT(q, true)));
        return rayQueryGetIntersectionTEXT(q, true);
    }
    return -1.0;
}

// Emission at a hit, only from the game's emissive target (on screen) or the per-mesh cache
// learned from it. Without that target Emission() falls back to the mesh's mean lit screen
// colour, which holds the light's own light, so it is not evidence and counts as zero.
float VisEmission(uint id, vec3 hit) {
    if ((BounceFlags() & BounceFlagEmissive) == 0u) {
        return 0.0;
    }
    const float e = Luma(Emission(id, EmptySurface(), hit));
    return isnan(e) || isinf(e) ? 0.0 : max(e, 0.0);
}

// One tap of the 5x5 screen window (0.3 m across at the light's depth) around the light: the
// emissive target where the scene depth is within reach of the light. The centre tap also
// reports whether the light position is on screen and not hidden behind nearer geometry.
float VisScreenTap(vec3 center, uint tap) {
    if (center.z <= 0.05) {
        return 0.0;
    }
    const float reach = vis_emit_dist + 0.02 * center.z;
    const float px_per_m = proj.x * Size().x * 0.5 / center.z;
    const float step = clamp(VisScreenRadius * px_per_m, 1.0, 16.0) * 0.5;
    const vec2 pixel = ViewToPixel(center, proj, Jitter()) +
                       vec2(float(int(tap % 5u) - 2), float(int(tap / 5u) - 2)) * step;
    const ivec2 ip = ivec2(floor(pixel + 0.5));
    if (any(lessThan(ip, ivec2(0))) || any(greaterThanEqual(ip, ivec2(Size())))) {
        return 0.0;
    }
    const float scene_z = ViewZ(DepthAt(ip));
    if (tap == VisScreenCentre) {
        vis_screen = vec2(scene_z >= center.z - reach ? 1.0 : 0.0, scene_z - center.z);
    }
    if ((BounceFlags() & BounceFlagEmissive) == 0u || abs(scene_z - center.z) > reach) {
        return 0.0;
    }
    const vec3 e = texelFetch(emissive_tex, ip, 0).rgb;
    return Finite(e) ? Luma(clamp(e, vec3(0.0), vec3(Clamp()))) : 0.0;
}

void main() {
    const uint light = gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationIndex;
    const bool valid_light = light < min(vis_count, MaxLightVis);
    const uint n = max(vis_rays, 1u);
    float sky = 0.0, emit = 0.0, luma = 0.0, near_solid = MissHitDistance;
    float enclosed = 0.0, blended = 0.0, near_blended = MissHitDistance, screen_luma = 0.0;
    vec2 up = vec2(0.0);
    if (lane == VisScreenCentre) {
        vis_screen = vec2(0.0);
    }
    barrier();
    if (valid_light) {
        const vec3 center = vis_in[light].xyz;
        if (lane < VisScreenTaps) {
            screen_luma = VisScreenTap(center, lane);
        }
        const float reach = max(vis_emit_dist - vis_offset, 0.0);
        for (uint i = lane; i < n; i += VisThreads) {
            const vec3 w = FibonacciDir(i, n);
            const vec3 v = vec3(dot(view_rows[0].xyz, w), dot(view_rows[1].xyz, w),
                                dot(view_rows[2].xyz, w));
            if (!Finite(v) || dot(v, v) < 1e-6) {
                continue;
            }
            const vec3 dir = normalize(v);
            const vec3 origin = center + dir * vis_offset;
            uint id, primitive;
            vec2 barycentrics;
            mat3 rotation;
            uint rejected = 0u;
            float t = TraceSpan(origin, dir, 0.0, 1e6, MaskSolid | MaskKept, id, primitive,
                                barycentrics, rotation, rejected);
            // A character (skinned surface) next to the light is not its fixture: look past it.
            if (t >= 0.0 && id < surfaces.length() && (surfaces[id].flags & SurfaceSkinned) != 0u) {
                const float t2 = TraceSpan(origin, dir, t + 0.01, 1e6, MaskSolid | MaskKept, id,
                                           primitive, barycentrics, rotation, rejected);
                t = t2;
            }
            bool near_hit = false;
            float ray_emit = 0.0;
            if (t >= 0.0) {
                near_solid = min(near_solid, t + vis_offset);
                if (t <= reach) {
                    near_hit = true;
                    ray_emit = VisEmission(id, origin + dir * t);
                }
            }
            const float b_max = t >= 0.0 ? min(t, reach) : reach;
            if (b_max > 0.0) {
                uint bid, bprim;
                vec2 bbary;
                mat3 brot;
                const float bt = VisBlendedHit(origin, dir, b_max, bid, bprim, bbary, brot);
                if (bt >= 0.0) {
                    near_hit = true;
                    blended += 1.0;
                    near_blended = min(near_blended, bt + vis_offset);
                    ray_emit = max(ray_emit, VisEmission(bid, origin + dir * bt));
                }
            }
            enclosed += near_hit ? 1.0 : 0.0;
            if (w.y > 0.5) {
                up += vec2(near_hit ? 1.0 : 0.0, 1.0);
            }
            luma = max(luma, ray_emit);
            emit += ray_emit > vis_emit_luma ? 1.0 : 0.0;
            if (t < 0.0) {
                sky += VisSkyTransmittance(origin, dir);
            }
        }
    }
    vis_a[lane] = vec4(sky, emit, luma, near_solid);
    vis_b[lane] = vec4(enclosed, blended, near_blended, screen_luma);
    vis_up[lane] = up;
    barrier();
    if (valid_light && lane == 0u) {
        vec4 a = vec4(0.0, 0.0, 0.0, MissHitDistance);
        vec4 b = vec4(0.0, 0.0, MissHitDistance, 0.0);
        vec2 u = vec2(0.0);
        for (uint k = 0u; k < VisThreads; ++k) {
            u += vis_up[k];
            const vec4 ka = vis_a[k], kb = vis_b[k];
            a = vec4(a.x + ka.x, a.y + ka.y, max(a.z, ka.z), min(a.w, ka.w));
            b = vec4(b.x + kb.x, b.y + kb.y, min(b.z, kb.z), max(b.w, kb.w));
        }
        const float inv = 1.0 / float(n);
        const uint o = light * VisOutputs;
        vis_out[o] = vec4(a.x * inv, a.y * inv, a.z, a.w);
        vis_out[o + 1u] = vec4(b.x * inv, b.y * inv, b.z, b.w);
        vis_out[o + 2u] = vec4(vis_screen, u.y > 0.0 ? u.x / u.y : 0.0, 0.0);
    }
}
#elif defined(RT_SKY_LAYER)
// The game's moon and cloud layer (BB_RT_MOON_FROM_SKY): a blended band mesh around the camera
// (pixel shader rt_gi.h SkyLayerPs) that the TLAS holds under its own mask bit. Phase 0 traces
// it from the camera over a world azimuth x elevation grid and stores premultiplied rgb and
// coverage; phase 1 (one workgroup) finds the moon disc there and stores its world direction
// in the moon slot for rt_moon_dir.comp. No look at the sky is needed and nothing on screen
// (fire, cloud gaps, exposure) can pass for the moon. Hits whose texture is unknown come out
// magenta in the grid (debug view BB_RT_SKY_DEBUG=4).
layout(push_constant) uniform SkyLayerPush {
    uint layer_base; // material slot of grid cell 0 (rt_gi.h SkyLayerSlot)
    uint moon_slot;  // rt_gi.h MoonDirSlot
    uint layer_phase;
    float moon_min;  // weakest-channel score a disc needs
    // Direction from the camera to the cached moon of this sky model (rt_moon_cache.h; w 1 when
    // known): the game draws the disc only while it is in view, so a load facing away starts
    // from the cache.
    vec4 moon_seed;
    uint moon_reset; // 1 on the first search after a load: drop the last map's moon
};
const uint MaskSky = 0x80u;     // rt_geometry.h MaskSky
const uint LayerW = 512u;       // rt_gi.h SkyLayerWidth
const uint LayerH = 128u;       // rt_gi.h SkyLayerHeight
const float LayerElMin = -20.0; // rt_gi.h SkyLayerElMin, degrees
const float LayerElMax = 90.0;  // rt_gi.h SkyLayerElMax
// Searches (rt_gi.h SkyLayerEvery frames apart) the moon is kept once the layer is gone (a load,
// an interior). While the layer draws, a known moon is kept with no limit: the game draws the
// disc only while it is in view, so looking at the ground drops it from the layer. w is MoonHold
// only on the search that found the disc (the CPU caches those, rt_moon_cache.h); a kept or
// seeded moon has MoonHold - 1.
const float MoonHold = 150.0;
const int MoonWindow = 12;      // cells around the peak for the weighted centre (a big moon is ~6 cells in radius)
// A disc, not a pale cloud: the peak must be MoonContrast x the mean score on a ring about 5
// degrees out (7 azimuth cells, 6 elevation cells). Clouds are wide, so their ring is as pale.
const float MoonContrast = 4.0;
const uint MoonRingTaps = 16u;
const vec4 LayerUnknown = vec4(1.0, 0.0, 1.0, 0.5);

vec3 LayerDir(vec2 cell) {
    const float az = radians((cell.x / float(LayerW)) * 360.0 - 180.0);
    const float el = radians(mix(LayerElMin, LayerElMax, cell.y / float(LayerH)));
    return vec3(cos(el) * sin(az), sin(el), cos(el) * cos(az));
}

vec4 LayerTexel(uint instance, uint primitive, vec2 b) {
    if (instance >= surfaces.length()) {
        return LayerUnknown;
    }
    const SurfaceRecord r = surfaces[instance];
    const uint base = r.uv_base + primitive * TriangleWords;
    if ((r.flags & SurfaceUsable) != SurfaceUsable || r.texture == 0u ||
        r.texture >= MaxSurfaceTextures || base + 2u >= uv_pool.length()) {
        return LayerUnknown;
    }
    const vec2 u0 = unpackHalf2x16(uv_pool[base]);
    const vec2 u1 = unpackHalf2x16(uv_pool[base + 1u]);
    const vec2 u2 = unpackHalf2x16(uv_pool[base + 2u]);
    const vec2 uv = u0 * (1.0 - b.x - b.y) + u1 * b.x + u2 * b.y;
    const vec4 t = textureLod(surface_textures[nonuniformEXT(r.texture)], uv, 0.0);
    if (any(isnan(t)) || any(isinf(t))) {
        return vec4(0.0);
    }
    return vec4(max(t.rgb, vec3(0.0)), clamp(t.a, 0.0, 1.0));
}

// Every layer surface along the ray, composited without order (premultiplied sum, coverage).
vec4 LayerTrace(vec3 w) {
    const vec3 v = vec3(dot(view_rows[0].xyz, w), dot(view_rows[1].xyz, w), dot(view_rows[2].xyz, w));
    if (!Finite(v) || dot(v, v) < 1e-6) {
        return vec4(0.0);
    }
    const vec3 dir = normalize(v);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_frame_flags.xy), gl_RayFlagsNoOpaqueEXT,
                          MaskSky, TlasPoint(tlas_frame_flags.xy, vec3(0.0)), 0.0,
                          TlasDir(tlas_frame_flags.xy, dir), 1e6);
    vec3 rgb = vec3(0.0);
    float clear = 1.0;
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            const vec4 c = LayerTexel(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false)),
                                      uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false)),
                                      rayQueryGetIntersectionBarycentricsEXT(q, false));
            rgb += c.rgb * c.a;
            clear *= 1.0 - c.a;
        }
    }
    return vec4(rgb, 1.0 - clear);
}

// Distance from the camera to the first mostly opaque layer texel along world direction w.
float LayerHitT(vec3 w) {
    const vec3 v = vec3(dot(view_rows[0].xyz, w), dot(view_rows[1].xyz, w), dot(view_rows[2].xyz, w));
    if (!Finite(v) || dot(v, v) < 1e-6) {
        return 0.0;
    }
    const vec3 dir = normalize(v);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_frame_flags.xy), gl_RayFlagsNoOpaqueEXT,
                          MaskSky, TlasPoint(tlas_frame_flags.xy, vec3(0.0)), 0.0,
                          TlasDir(tlas_frame_flags.xy, dir), 1e6);
    float best = 0.0;
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            const vec4 c = LayerTexel(uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false)),
                                      uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false)),
                                      rayQueryGetIntersectionBarycentricsEXT(q, false));
            const float t = rayQueryGetIntersectionTEXT(q, false);
            if (c.a > 0.5 && min(c.r, min(c.g, c.b)) > moon_min && (best == 0.0 || t < best)) {
                best = t;
            }
        }
    }
    return best;
}

// The moon is near white; the layer's clouds are red or grey. The weakest channel scores it.
float LayerWhite(uint i) {
    const uint slot = layer_base + i;
    if (slot >= material.length()) {
        return 0.0;
    }
    const vec4 m = material[slot];
    return Finite(m.rgb) ? max(min(m.r, min(m.g, m.b)), 0.0) : 0.0;
}

shared float l_peak[64];
shared uint l_at[64];
shared vec3 l_sum[64];
shared uint l_cover;

void FindLayerMoon() {
    const uint t = gl_LocalInvocationIndex;
    if (t == 0u) {
        l_cover = 0u;
    }
    barrier();
    float peak = 0.0;
    uint cover = 0u;
    uint at = 0u;
    // Rows above the horizon (y > 0.02, about 1.2 degrees).
    const uint first = uint(ceil((degrees(asin(0.02)) - LayerElMin) / (LayerElMax - LayerElMin) *
                                 float(LayerH) - 0.5));
    for (uint i = t + first * LayerW; i < LayerW * LayerH; i += 64u) {
        const float s = LayerWhite(i);
        if (s > peak) {
            peak = s;
            at = i;
        }
        const uint slot = layer_base + i;
        cover += slot < material.length() && material[slot].a > 0.01 ? 1u : 0u;
    }
    atomicAdd(l_cover, cover);
    l_peak[t] = peak;
    l_at[t] = at;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (t < stride && l_peak[t + stride] > l_peak[t]) {
            l_peak[t] = l_peak[t + stride];
            l_at[t] = l_at[t + stride];
        }
        barrier();
    }
    const float top = l_peak[0];
    const ivec2 c0 = ivec2(l_at[0] % LayerW, l_at[0] / LayerW);
    // Three rings (about 5, 10 and 17 degrees out); the darkest one counts. Later in the game the
    // moon grows to ~8 degrees across: the 5 degree ring then lay on the disc and its glow, so the
    // moon was never found and the light kept a stale cached direction while the player faced it.
    vec3 ring = vec3(0.0);
    if (t < MoonRingTaps) {
        const float a = float(t) * (6.28318530718 / float(MoonRingTaps));
        const vec2 cs = vec2(cos(a), sin(a));
        for (int r = 0; r < 3; ++r) {
            const vec2 radius = r == 0 ? vec2(7.0, 6.0) : r == 1 ? vec2(14.0, 12.0) : vec2(24.0, 20.0);
            const ivec2 c = c0 + ivec2(round(radius * cs));
            const int y = clamp(c.y, 0, int(LayerH) - 1);
            ring[r] = LayerWhite(uint(y) * LayerW + uint((c.x + int(LayerW)) % int(LayerW)));
        }
    }
    l_sum[t] = ring;
    barrier();
    vec3 ring_sum = vec3(0.0);
    for (uint k = 0u; k < MoonRingTaps; ++k) {
        ring_sum += l_sum[k];
    }
    barrier();
    const float ring_mean = min(ring_sum.x, min(ring_sum.y, ring_sum.z)) / float(MoonRingTaps);
    const bool found = top > moon_min && top > MoonContrast * ring_mean;
    vec3 sum = vec3(0.0);
    if (found) {
        const int span = 2 * MoonWindow + 1;
        for (int k = int(t); k < span * span; k += 64) {
            const ivec2 o = ivec2(k % span, k / span) - MoonWindow;
            const int y = c0.y + o.y;
            if (y < 0 || y >= int(LayerH)) {
                continue;
            }
            const int x = (c0.x + o.x + int(LayerW)) % int(LayerW);
            const float s = LayerWhite(uint(y) * LayerW + uint(x));
            if (s > 0.5 * top) {
                sum += LayerDir(vec2(x, y) + 0.5) * (s - 0.5 * top);
            }
        }
    }
    l_sum[t] = sum;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (t < stride) {
            l_sum[t] += l_sum[t + stride];
        }
        barrier();
    }
    if (t != 0u || moon_slot >= material.length()) {
        return;
    }
    const vec3 view_t = vec3(view_rows[0].w, view_rows[1].w, view_rows[2].w);
    const vec3 cam = -(view_rows[0].xyz * view_t.x + view_rows[1].xyz * view_t.y +
                       view_rows[2].xyz * view_t.z);
    // Cells this code wrote carry w = MoonCellTag (grid coverage is at most 1): the old grid
    // values there passed as a sighting and a position and swung the light 29 degrees.
    const float MoonCellTag = 4.0;
    // A camera jump between two searches (a warp, a load) is another map with another moon:
    // start over (row 0 cell 4: the camera of the last search). The CPU's reset (the layer's
    // draws came back after a second away: a load, but also a look at the ground or a walk
    // under a roof) only counts while this run has no moon placed in the world: it dropped the
    // found moon and the light went back to the cached direction of the cloud draws, which other
    // maps share (Cathedral Ward: 30 degrees off), until the player looked at the disc again.
    const float MoonJump = 100.0;
    const uint own_last = layer_base + 4u;
    const vec4 last = material[own_last];
    const bool jumped = last.w == MoonCellTag && Finite(last.xyz) && Finite(cam) &&
                        distance(last.xyz, cam) > MoonJump;
    const bool placed = material[layer_base].w == MoonCellTag;
    // No tagged camera yet: the first search of a session (or of this layout of the cells).
    const bool reset = jumped || last.w != MoonCellTag || ((moon_reset & 1u) != 0u && !placed);
    material[own_last] = vec4(cam, MoonCellTag);
    vec4 m = material[moon_slot];
    if (!Finite(m.xyz) || !(m.w > 0.0) || reset) {
        m = vec4(0.0);
    }
    const uint stats = layer_base + LayerW * LayerH;
    // The moon on screen (rt_sky.comp FindScreenMoon, written every frame): the disc the player
    // sees. It wins over the layer mesh's white spot, which only counts with BB_RT_MOON_LAYER_FIND=1.
    const vec4 screen = stats + 2u < material.length() ? material[stats + 2u] : vec4(0.0);
    // The disc's range in metres (rt_sky.comp FindScreenMoon, its stats slot).
    const float screen_range = stats + 3u < material.length() ? material[stats + 3u].w : 0.0;
    // Its glow (luminance over the sky's just past it): the moon is the disc with the most.
    const float screen_glow = stats + 3u < material.length() ? material[stats + 3u].x : 0.0;
    bool on_screen = screen.w > 0.0 && Finite(screen.xyz) && dot(screen.xyz, screen.xyz) > 0.5;
    // w -1: the search ran and found no disc.
    const bool search_ran = on_screen || screen.w < 0.0;
    if (search_ran) {
        material[stats + 2u].w = 0.0; // used once
    }
    // Finds carry rt_sky.comp ScreenMoonTag: they passed the disc test (a round mesh in front of
    // the sky, any colour). Untagged finds never count: lit clouds out of view replaced the moon
    // and the light swung as the player walked. The first disc of a run replaces the kept moon
    // (the game's or the cache's direction) once it was found MoonFirst times at one spot (row 0
    // cell 3: the spot, w 10 + the count, then 2 = a disc was seen; reset on load). At once, one
    // stray find in the Nightmare Frontier, whose sky has no moon, placed a moon behind the
    // rocks and the whole map sat in its shadow until the next warp.
    const float MoonFirst = 3.0;
    const float MoonFirstDir = 0.99863; // cos(3 degrees)
    const uint own_disc = layer_base + 3u;
    const bool screen_disc = on_screen && fract(screen.w) > 0.25;
    const bool disc_seen = !reset && material[own_disc].w == 2.0;
    bool confirm = false; // this search is the one that makes the first disc count
    if (screen_disc && !disc_seen) {
        const vec4 spot = reset ? vec4(0.0) : material[own_disc];
        const bool same = Finite(spot.xyz) && dot(spot.xyz, spot.xyz) > 0.5 && spot.w >= 10.0 &&
                          dot(normalize(screen.xyz), spot.xyz) > MoonFirstDir;
        const float count = same ? spot.w - 10.0 + 1.0 : 1.0;
        confirm = count >= MoonFirst;
        material[own_disc] = vec4(normalize(screen.xyz), confirm ? 2.0 : 10.0 + count);
        if (!confirm) {
            on_screen = false; // not yet
        }
    } else if (reset) {
        material[own_disc] = vec4(0.0);
    }
    if (!screen_disc) {
        on_screen = false;
    }
    const bool layer_find = (moon_reset & 2u) != 0u;
    const vec3 d = on_screen ? screen.xyz : (layer_find && found ? l_sum[0] : vec3(0.0));
    const bool seeded = moon_seed.w > 0.0 && Finite(moon_seed.xyz) && dot(moon_seed.xyz, moon_seed.xyz) > 0.5;
    vec3 found_dir = vec3(0.0);
    // The disc the game draws is a mesh a few hundred metres out (two sightings 150 m apart at the
    // cathedral met within 4 m, 250-390 m away), so a kept direction drifted 13 degrees as the
    // player walked. Each run triangulates the disc from its own sightings, kept in grid row 0
    // (below the horizon, never searched; phase 0 leaves these cells): cell 0 the position (w 1),
    // cell 1 the camera of the last sighting (w 1), cell 2 its direction. Out of view the light
    // points from the camera at that position. A find always wins over the cached seed: cloud
    // segments are shared between areas, so the seed can be another area's moon (the cathedral
    // got Hunter's Dream's, 15 degrees off). w = MoonOwn marks a moon found this run.
    const float MoonOwn = MoonHold - 0.5;
    const float MoonBaseline = 10.0;      // metres walked between sightings for a triangulation
    const float MoonMinParallax = 3.0e-4; // sin^2 of 1 degree between the two sightings
    const uint own_pos = layer_base, own_cam = layer_base + 1u, own_dir = layer_base + 2u;
    vec4 pos = material[own_pos];
    vec4 s_cam = material[own_cam];
    vec4 s_dir = material[own_dir];
    if (reset || !Finite(pos.xyz) || !Finite(s_cam.xyz) || !Finite(s_dir.xyz) ||
        !Finite(cam)) {
        pos = vec4(0.0);
        s_cam = vec4(0.0);
        s_dir = vec4(0.0);
    }
    pos.w = pos.w == MoonCellTag ? 1.0 : 0.0;
    s_cam.w = s_cam.w == MoonCellTag ? 1.0 : 0.0;
    // The first disc of the run, once confirmed, replaces whatever was kept.
    if (confirm) {
        pos = vec4(0.0);
        s_cam = vec4(0.0);
        s_dir = vec4(0.0);
        m = vec4(0.0);
    }
    const bool own = m.w >= MoonOwn && dot(m.xyz, m.xyz) > 0.5;
    // Row 0 cell 5: the glow of the kept moon (x) and of the stray spot being counted (y).
    const uint own_glow = layer_base + 5u;
    vec2 glow = material[own_glow].w == MoonCellTag && !reset && !confirm
                    ? material[own_glow].xy : vec2(0.0);
    if (any(isnan(glow)) || any(isinf(glow))) {
        glow = vec2(0.0);
    }
    bool take = dot(d, d) > 0.0 && Finite(normalize(d)) && normalize(d).y > 0.02;
    // The moon is static in the world: once this run has one (triangulated, or else the first
    // find), a find off it is a stray and is dropped. A small bright patch at the horizon in
    // Hemwick passed as the disc now and then and flicked the light between it and the moon.
    // Off by MoonAgree from the position (3 degrees), or MoonAgreeDir from a direction-only moon
    // (10: walking turns the disc until it is triangulated). A spot seen elsewhere steadily
    // replaces the kept moon, so one wrong first find does not stick for the whole run: s_dir.w
    // counts sightings of one stray spot (cell 3 xyz, within MoonAgreeDir), less MoonEmptyCost
    // per search with no disc, and MoonUnlock replaces. A sighting elsewhere restarts it, one of
    // the kept moon clears it. A plain count let a spot that passed about 1 search in 4 with the
    // camera still replace the moon after 300 frames; the moon in view passes every search, so
    // a wrong first find still unlocks in under a second (12 searches, 4 frames apart).
    const float MoonAgree = 0.99863;    // cos(3 degrees)
    const float MoonAgreeDir = 0.98481; // cos(10 degrees)
    const float MoonUnlock = 12.0;
    const float MoonEmptyCost = 2.0;
    const float MoonFindBlend = 0.1;
    if (isnan(s_dir.w) || isinf(s_dir.w)) {
        s_dir.w = 0.0;
    }
    vec3 kept = vec3(0.0);
    if (pos.w > 0.0 && dot(pos.xyz - cam, pos.xyz - cam) > 1.0) {
        kept = normalize(pos.xyz - cam);
    } else if (own) {
        kept = normalize(m.xyz);
    }
    // The kept moon in the middle of the view and not found there: its glow fades, so a kept
    // disc that is one no longer (the Nightmare Frontier's rock, once the search stopped passing
    // it) gives way to the next one seen.
    const float MoonGlowFade = 0.97;
    const float MoonCentred = 0.96593; // cos(15 degrees) from the view's axis
    const bool found_kept = take && dot(kept, kept) > 0.5 &&
                            dot(normalize(d), kept) >= (pos.w > 0.0 ? MoonAgree : MoonAgreeDir);
    if (search_ran && dot(kept, kept) > 0.5 && !found_kept &&
        dot(normalize(view_rows[2].xyz), kept) > MoonCentred) {
        glow.x *= MoonGlowFade;
    }
    if (take && dot(kept, kept) > 0.5 &&
        dot(normalize(d), kept) < (pos.w > 0.0 ? MoonAgree : MoonAgreeDir)) {
        const vec3 stray = material[own_disc].xyz;
        const bool same = Finite(stray) && dot(stray, stray) > 0.5 && dot(normalize(d), stray) > MoonAgreeDir;
        s_dir.w = same ? max(s_dir.w, 0.0) + 1.0 : 1.0;
        material[own_disc].xyz = normalize(d);
        // A disc with less glow never replaces the kept one: a moonlit round cloud in the
        // Hunter's Dream (glow 1.4, the moon 1.6-2.6) took the light for as long as the camera
        // rested on it. Found first, it still gives way to the moon.
        glow.y = same && on_screen ? mix(glow.y, screen_glow, 0.25) : screen_glow;
        if (s_dir.w < MoonUnlock || (on_screen && glow.x > 0.0 && glow.y <= glow.x)) {
            take = false;
        } else {
            glow.x = 0.0;
            pos = vec4(0.0);
            s_cam = vec4(0.0);
            s_dir = vec4(0.0);
        }
    } else if (search_ran && !screen_disc) {
        s_dir.w = max(s_dir.w - MoonEmptyCost, 0.0);
    }
    if (take) {
        found_dir = normalize(d);
        // Finds on one moon scatter (about 1 degree when the disc is half off screen), so one
        // that agrees with this run's moon moves it a tenth of the way.
        if (own && dot(found_dir, normalize(m.xyz)) >= MoonAgreeDir) {
            found_dir = normalize(mix(normalize(m.xyz), found_dir, MoonFindBlend));
        }
        m = vec4(found_dir, MoonHold);
        s_dir.w = 0.0;
        if (on_screen) {
            glow.x = glow.x > 0.0 ? mix(glow.x, screen_glow, 0.1) : screen_glow;
        }
        // The disc on screen comes with its range (depth): the moon's place in the world at
        // once, from one look. Two sightings a walk apart (below) only serve a layer find.
        const bool ranged = on_screen && screen_range > 50.0 && screen_range < 5.0e4;
        if (ranged) {
            // The first find places it; later ones move it a twentieth of the way (finds 4
            // frames apart: about a second to settle). Finds of one disc scatter 0.4-0.7 degrees
            // (the blood moon's rims next to a cloud sheet, Upper Cathedral Ward's half disc); at
            // a quarter of the way the light crept with them.
            const vec3 x = cam + normalize(d) * screen_range;
            pos = vec4(pos.w > 0.0 ? mix(pos.xyz, x, 0.05) : x, 1.0);
            s_cam = vec4(cam, 1.0);
            s_dir = vec4(found_dir, 0.0);
        }
        const vec3 walked = cam - s_cam.xyz;
        if (!ranged && s_cam.w > 0.0 && dot(walked, walked) > MoonBaseline * MoonBaseline) {
            // Closest points of the rays s_cam + t0 * d0 and cam + t1 * found_dir.
            const vec3 d0 = s_dir.xyz;
            const float k = dot(d0, found_dir);
            const float den = 1.0 - k * k;
            if (den > MoonMinParallax) {
                const vec3 w0 = s_cam.xyz - cam;
                const float e = dot(d0, w0), f = dot(found_dir, w0);
                const float t0 = (k * f - e) / den;
                const float t1 = (f - k * e) / den;
                const vec3 x0 = s_cam.xyz + d0 * t0, x1 = cam + found_dir * t1;
                if (t0 > 50.0 && t1 > 50.0 && distance(x0, x1) < 0.05 * t1) {
                    const vec3 x = 0.5 * (x0 + x1);
                    pos = vec4(pos.w > 0.0 ? mix(pos.xyz, x, 0.25) : x, 1.0);
                }
                s_cam = vec4(cam, 1.0);
                s_dir = vec4(found_dir, 0.0);
            } else if (dot(walked, walked) > 16.0 * MoonBaseline * MoonBaseline) {
                // Under a degree over 40 m: the disc is kilometres out, a direction is enough.
                pos = vec4(0.0);
                s_cam = vec4(cam, 1.0);
                s_dir = vec4(found_dir, 0.0);
            }
        } else if (!(s_cam.w > 0.0)) {
            s_cam = vec4(cam, 1.0);
            s_dir = vec4(found_dir, 0.0);
        }
    } else if (l_cover > 0u) {
        // The layer still draws (clouds) without the disc: the moon is out of view. Keep this
        // run's moon, else point at the cached moon of this sky from this camera, or keep the
        // last find.
        if (own) {
            m.w = MoonOwn;
        } else if (seeded) {
            m = vec4(normalize(moon_seed.xyz), MoonHold - 1.0);
        } else if (m.w > 0.0) {
            m.w = MoonHold - 1.0;
        }
    } else if (seeded) {
        // No layer draw (the view points at the ground): the CPU still seeds this sky's moon
        // for a while (vk_ray_tracing.cpp MoonSeedHold), so shadows keep their direction.
        m = own ? vec4(m.xyz, MoonOwn) : vec4(normalize(moon_seed.xyz), MoonHold - 1.0);
    } else if (own && pos.w > 0.0) {
        // Placed in the world this run: kept until a load or a jump. Skies with no layer draws
        // (Cathedral Ward under the blood moon) lost it 150 searches after the disc left the
        // screen and fell back to the game's direction until the player looked up again.
        m.w = MoonOwn;
    } else {
        m.w = max(m.w - 1.0, 0.0);
        if (m.w == 0.0) {
            m = vec4(0.0);
        }
    }
    // With a position the light always points at it, on a find too: the moon stays put.
    if (m.w > 0.0 && (own || m.w == MoonHold) && pos.w > 0.0) {
        const vec3 to = pos.xyz - cam;
        if (dot(to, to) > 1.0 && Finite(normalize(to)) && normalize(to).y > 0.02) {
            m.xyz = normalize(to);
        }
    }
    material[moon_slot] = m;
    material[own_pos] = vec4(pos.xyz, pos.w > 0.0 ? MoonCellTag : 0.0);
    material[own_cam] = vec4(s_cam.xyz, s_cam.w > 0.0 ? MoonCellTag : 0.0);
    material[own_dir] = s_dir;
    material[own_glow] = vec4(glow, 0.0, MoonCellTag);
    if (stats < material.length()) {
        material[stats] = vec4(top, ring_mean, float(c0.x), float(c0.y));
    }
    if (stats + 1u < material.length()) {
        // The distance the CPU caches the find at: the layer hit, or for the disc on screen the
        // triangulated distance (ScreenMoonDistance until there is one; no mesh to hit).
        const float ScreenMoonDistance = 2000.0;
        const float screen_t = pos.w > 0.0 ? distance(pos.xyz, cam) : ScreenMoonDistance;
        material[stats + 1u] = vec4(
            m.w == MoonHold ? (on_screen ? screen_t : LayerHitT(found_dir)) : 0.0, found_dir);
    }
}

void main() {
    if (layer_phase == 1u) {
        FindLayerMoon();
        return;
    }
    const uvec2 c = gl_GlobalInvocationID.xy;
    if (c.x >= LayerW || c.y >= LayerH) {
        return;
    }
    if (c.y == 0u && c.x < 6u) {
        return; // FindLayerMoon's own-moon cells
    }
    const uint slot = layer_base + c.y * LayerW + c.x;
    if (slot < material.length()) {
        material[slot] = LayerTrace(LayerDir(vec2(c) + 0.5));
    }
}
