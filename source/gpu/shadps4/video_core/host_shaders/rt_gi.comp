Surface EmptySurface() {
    Surface s;
    s.albedo = vec3(0.0);
    s.alpha = 1.0;
    s.normal = vec3(0.0);
    s.valid = false;
    return s;
}

Surface HitSurface(uint instance, uint primitive, vec2 barycentrics, mat3 rotation) {
    Surface s = EmptySurface();
    if (instance >= surfaces.length()) {
        return s;
    }
    const SurfaceRecord r = surfaces[instance];
    const uint base = r.uv_base + primitive * TriangleWords;
    if ((r.flags & SurfaceHasNormal) == 0u || base + 3u >= uv_pool.length()) {
        return s;
    }
    const vec3 local_n = unpackSnorm4x8(uv_pool[base + 3u]).xyz;
    vec3 geo_n = vec3(0.0);
    if (dot(local_n, local_n) > 0.5) {
        const vec3 n = rotation * local_n;
        geo_n = dot(n, n) > 0.0 ? normalize(n) : vec3(0.0);
        s.normal = geo_n;
    }
    if (dot(geo_n, geo_n) > 0.5 && base + 7u < uv_pool.length()) {
        const vec3 n0 = unpackSnorm4x8(uv_pool[base + 4u]).xyz;
        const vec3 n1 = unpackSnorm4x8(uv_pool[base + 5u]).xyz;
        const vec3 n2 = unpackSnorm4x8(uv_pool[base + 6u]).xyz;
        if (dot(n0, n0) > 0.5 && dot(n1, n1) > 0.5 && dot(n2, n2) > 0.5) {
            const vec3 li = n0 * (1.0 - barycentrics.x - barycentrics.y) + n1 * barycentrics.x +
                            n2 * barycentrics.y;
            if (dot(li, li) > 1e-6) {
                const vec3 vn = normalize(rotation * li);
                if (dot(vn, geo_n) > 0.0) {
                    s.normal = vn;
                }
            }
        }
    }
    if ((r.flags & SurfaceUsable) != SurfaceUsable || r.texture == 0u ||
        r.texture >= MaxSurfaceTextures) {
        return s;
    }
    const vec2 a = unpackHalf2x16(uv_pool[base]);
    const vec2 b = unpackHalf2x16(uv_pool[base + 1u]);
    const vec2 c = unpackHalf2x16(uv_pool[base + 2u]);
    const vec2 uv = a * (1.0 - barycentrics.x - barycentrics.y) + b * barycentrics.x + c * barycentrics.y;
    if (any(isnan(uv)) || any(isinf(uv))) {
        return s;
    }
    const uint normal_map = (r.flags >> SurfaceNormalMapShift) & 1023u;
    if (normal_map != 0u && normal_map < MaxSurfaceTextures && dot(s.normal, s.normal) > 0.5 &&
        base + 7u < uv_pool.length()) {
        const vec4 tw = unpackSnorm4x8(uv_pool[base + 7u]);
        if (dot(tw.xyz, tw.xyz) > 0.5) {
            const vec4 m = textureLod(surface_textures[nonuniformEXT(normal_map)], uv, SurfaceAlbedoLod);
            const float mx = m.r * 2.0 - 1.0;
            const float my = m.g * 2.0 - 1.0;
            const float mz = m.b > 0.0 ? m.b * 2.0 - 1.0 : sqrt(max(0.0, 1.0 - mx * mx - my * my));
            const vec3 nn = s.normal;
            vec3 t = rotation * tw.xyz;
            t -= nn * dot(t, nn);
            if (dot(t, t) > 1e-6 && !any(isnan(m))) {
                t = normalize(t);
                const vec3 bt = cross(nn, t) * (tw.w < 0.0 ? -1.0 : 1.0);
                const vec3 pn = t * mx + bt * my + nn * mz;
                if (dot(pn, pn) > 1e-6 && dot(pn, geo_n) > 0.0) {
                    s.normal = normalize(pn);
                }
            }
        }
    }
    const vec4 t = textureLod(surface_textures[nonuniformEXT(r.texture)], uv, SurfaceAlbedoLod);
    if (any(isnan(t))) {
        return s;
    }
    s.albedo = clamp(t.rgb, vec3(0.0), vec3(1.0));
    s.alpha = clamp(t.a, 0.0, 1.0);
    s.valid = true;
    return s;
}

uint SurfaceAlphaTexture(SurfaceRecord r) {
    const uint slot = (r.flags >> 6u) & 1023u;
    return slot != 0u ? slot : r.texture;
}

uint SurfaceAlphaChannel(SurfaceRecord r) {
    return ((r.flags >> 26u) & 3u) ^ 3u;
}

bool AlphaTestPasses(uint instance, uint primitive, vec2 barycentrics) {
    if (instance >= surfaces.length()) {
        return true;
    }
    const SurfaceRecord r = surfaces[instance];
    const uint alpha_tex = SurfaceAlphaTexture(r);
    if ((r.flags & SurfaceAlphaTest) == 0u || (r.flags & SurfaceHasUv) == 0u ||
        alpha_tex == 0u || alpha_tex >= MaxSurfaceTextures) {
        return true;
    }
    const uint base = r.uv_base + primitive * TriangleWords;
    if (base + 2u >= uv_pool.length()) {
        return true;
    }
    const vec2 a = unpackHalf2x16(uv_pool[base]);
    const vec2 b = unpackHalf2x16(uv_pool[base + 1u]);
    const vec2 c = unpackHalf2x16(uv_pool[base + 2u]);
    const vec2 uv = a * (1.0 - barycentrics.x - barycentrics.y) + b * barycentrics.x + c * barycentrics.y;
    const float alpha = textureLod(surface_textures[nonuniformEXT(alpha_tex)], uv, 0.0)[SurfaceAlphaChannel(r)];
    return !(alpha < r.alpha_ref);
}

// Glass at a hit: SurfaceGlass records. A masked one (alpha_ref < 0, RayTracing::GlassMaskSlots)
// is glass only where its hand-painted mask (texture slot -alpha_ref) is white: the bottle
// shelves mix glass and metal in one mesh.
bool GlassAt(uint instance, uint primitive, vec2 barycentrics) {
    if (instance >= surfaces.length()) {
        return false;
    }
    const SurfaceRecord r = surfaces[instance];
    if ((r.flags & 0x10000000u) == 0u) {
        return false;
    }
    if (!(r.alpha_ref < 0.0)) {
        return true;
    }
    const uint slot = uint(-r.alpha_ref + 0.5);
    const uint base = r.uv_base + primitive * TriangleWords;
    if (slot == 0u || slot >= MaxSurfaceTextures || (r.flags & 2u) == 0u ||
        base + 2u >= uv_pool.length()) {
        return false;
    }
    const vec2 a = unpackHalf2x16(uv_pool[base]);
    const vec2 b = unpackHalf2x16(uv_pool[base + 1u]);
    const vec2 c = unpackHalf2x16(uv_pool[base + 2u]);
    const vec2 uv = a * (1.0 - barycentrics.x - barycentrics.y) + b * barycentrics.x + c * barycentrics.y;
    return textureLod(surface_textures[nonuniformEXT(slot)], uv, 0.0).r > 0.5;
}

float SmokeAlpha(uint instance, uint primitive, vec2 barycentrics) {
    const SurfaceRecord r = surfaces[instance];
    if ((r.flags & SurfaceUsable) != SurfaceUsable || r.texture == 0u ||
        r.texture >= MaxSurfaceTextures) {
        return 1.0;
    }
    const uint base = r.uv_base + primitive * TriangleWords;
    if (base + 2u >= uv_pool.length()) {
        return 1.0;
    }
    const vec2 a = unpackHalf2x16(uv_pool[base]);
    const vec2 b = unpackHalf2x16(uv_pool[base + 1u]);
    const vec2 c = unpackHalf2x16(uv_pool[base + 2u]);
    const vec2 uv = a * (1.0 - barycentrics.x - barycentrics.y) + b * barycentrics.x + c * barycentrics.y;
    return textureLod(surface_textures[nonuniformEXT(r.texture)], uv, 0.0).a;
}

