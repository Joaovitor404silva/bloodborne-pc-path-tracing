layout(buffer_reference, std430, buffer_reference_align = 16) buffer SharcGrid {
    uint words[];
};
const uint SharcNone = 0xFFFFFFFFu;
const uint SharcSlotMask = (1u << 20u) - 1u;
const uint SharcEntryWords = 8u;
const uint SharcProbes = 8u;
const float SharcBaseCell = 0.25;
const float SharcCellPerMeter = 0.02;
const uint SharcMaxLevel = 15u;
const uint SharcScale = 4096u;
const float SharcMaxRadiance = 16.0;
const uint SharcFrameCap = 256u;
const float SharcMinWeight = 4.0;
const uint SharcUpdateMask = 7u;
const float SharcMinRayCells = 1.5;

bool SharcOn() { return sharc.z != 0u; }

uint SharcLevel(float distance) {
    const float want = distance * SharcCellPerMeter / SharcBaseCell;
    if (!(want > 1.0)) {
        return 0u;
    }
    const float level = ceil(log2(want));
    return level >= float(SharcMaxLevel) ? SharcMaxLevel : uint(level);
}

bool SharcMakeKey(vec3 hit, vec3 normal, out uvec2 key, out float size) {
    key = uvec2(0u);
    const uint level = SharcLevel(length(hit));
    size = SharcBaseCell * exp2(float(level));
    const vec3 w = WorldDir(hit - vec3(view_rows[0].w, view_rows[1].w, view_rows[2].w)) / size;
    const vec3 wn = WorldDir(normal);
    if (!Finite(w) || !Finite(wn) || any(greaterThan(abs(w), vec3(1.0e9)))) {
        return false;
    }
    const uvec3 c = uvec3(ivec3(floor(w))) & 0x1FFFFu;
    const uint octant = (wn.x < 0.0 ? 1u : 0u) | (wn.y < 0.0 ? 2u : 0u) | (wn.z < 0.0 ? 4u : 0u);
    key = uvec2(c.x | (c.y << 17u), (c.y >> 15u) | (c.z << 2u) | (level << 19u) | (octant << 23u));
    return true;
}

uint SharcHashSlot(uvec2 key) {
    return Hash(key.x ^ Hash(key.y)) & SharcSlotMask;
}

uint SharcChecksum(uvec2 key) {
    const uint c = Hash(key.y ^ Hash(key.x + 0x9E3779B9u));
    return c == 0u ? 1u : c;
}

uint SharcFind(uvec2 key) {
    SharcGrid g = SharcGrid(sharc.xy);
    const uint h = SharcHashSlot(key), cs = SharcChecksum(key);
    for (uint i = 0u; i < SharcProbes; ++i) {
        const uint s = (h + i) & SharcSlotMask;
        if (g.words[s * SharcEntryWords] == cs) {
            return s;
        }
    }
    return SharcNone;
}

uint SharcInsert(uvec2 key) {
    SharcGrid g = SharcGrid(sharc.xy);
    const uint h = SharcHashSlot(key), cs = SharcChecksum(key);
    for (uint i = 0u; i < SharcProbes; ++i) {
        const uint s = (h + i) & SharcSlotMask;
        const uint prev = atomicCompSwap(g.words[s * SharcEntryWords], 0u, cs);
        if (prev == 0u || prev == cs) {
            return s;
        }
    }
    return SharcNone;
}

bool SharcRead(uint s, out vec3 radiance) {
    radiance = vec3(0.0);
    SharcGrid g = SharcGrid(sharc.xy);
    const uint base = s * SharcEntryWords;
    const vec2 rg = unpackHalf2x16(g.words[base + 6u]);
    const vec2 bw = unpackHalf2x16(g.words[base + 7u]);
    const vec3 c = vec3(rg, bw.x);
    if (!(bw.y >= SharcMinWeight) || !Finite(c)) {
        return false;
    }
    if (g.words[base + 1u] != Frame()) {
        g.words[base + 1u] = Frame();
    }
    radiance = clamp(c, vec3(0.0), vec3(Clamp()));
    return true;
}

uint SharcEncode(float v) {
    return uint((isnan(v) ? 0.0 : clamp(v, 0.0, SharcMaxRadiance)) * float(SharcScale) + 0.5);
}

void SharcAdd(uint s, vec3 radiance) {
    SharcGrid g = SharcGrid(sharc.xy);
    const uint base = s * SharcEntryWords;
    g.words[base + 1u] = Frame();
    if (atomicAdd(g.words[base + 5u], 1u) >= SharcFrameCap) {
        return;
    }
    atomicAdd(g.words[base + 2u], SharcEncode(radiance.x));
    atomicAdd(g.words[base + 3u], SharcEncode(radiance.y));
    atomicAdd(g.words[base + 4u], SharcEncode(radiance.z));
}

bool SharcUpdatePath(ivec2 pixel) {
    return (Hash(uint(pixel.x) * 1973u ^ uint(pixel.y) * 9277u ^ (Frame() * 26699u + 0x5bd1e995u)) &
            SharcUpdateMask) == 0u;
