    if (debug == 4u) {
        WriteTileDebug(pixel, tile_lights);
        res_out[index] = Reservoir(NoLight, 0.0, 0u, 0u);
        return;
    }
    vec4 g3;
    const Surface s = MakeSurface(pixel, p, g3);
    uint seed = Seed(pixel);
    Res r = EmptyRes();
    if (tile_lights > 0u) {
        const float total = tile_cdf[tile_lights - 1u];
        const uint candidates = Candidates();
        for (uint c = 0u; c < candidates; ++c) {
            const float u = Rand(seed) * total;
            uint lo = 0u, hi = tile_lights - 1u;
            while (lo < hi) {
                const uint mid = (lo + hi) >> 1u;
                if (tile_cdf[mid] <= u) {
                    lo = mid + 1u;
                } else {
                    hi = mid;
                }
            }
            const float pdf = (tile_cdf[lo] - (lo > 0u ? tile_cdf[lo - 1u] : 0.0)) / total;
            const uint light = tile_list[lo];
            const float p_hat = TargetPdf(light, s);
            ResUpdate(r, light, pdf > 0.0 ? p_hat / pdf : 0.0, p_hat, Rand(seed));
        }
    }
    if ((Flags() & FlagRestirReset) == 0u && MaxHistory() > 0u) {
        const vec3 prev = vec3(dot(reproject[0], vec4(p, 1.0)), dot(reproject[1], vec4(p, 1.0)),
                               dot(reproject[2], vec4(p, 1.0)));
        if (abs(prev.z) > 1e-4) {
            const ivec2 prev_pixel = ivec2(floor(ViewToPixel(prev, prev_proj, prev_jitter.xy) + 0.5));
            if (all(greaterThanEqual(prev_pixel, ivec2(0))) && all(lessThan(prev_pixel, ivec2(size)))) {
                const Reservoir h = res_in[PixelIndex(prev_pixel)];
                const vec3 n_prev = vec3(dot(reproject[0].xyz, s.n), dot(reproject[1].xyz, s.n),
                                         dot(reproject[2].xyz, s.n));
                float hm, hp;
                if (Similar(h, prev.z, n_prev, hm, hp) && h.light < PrevLightCount()) {
                    const uint light = remap[h.light];
                    if (light != NoLight) {
                        const float p_hat = TargetPdf(light, s);
                        ResMerge(r, light, h.weight, min(hm, float(MaxHistory())), p_hat, Rand(seed));
                    }
                }
            }
        }
    }
    res_out[index] = Pack(r, p.z, s.n);
#else
    if (!surface || debug == 2u || debug == 4u) {
        if (inside) {
            res_out[PixelIndex(pixel)] = Reservoir(NoLight, 0.0, 0u, 0u);
        }
        return;
    }
    const uint index = PixelIndex(pixel);
    vec4 g3;
    const Surface s = MakeSurface(pixel, p, g3);
    uint seed = Seed(pixel);
    const Reservoir own = res_in[index];
    Res r = EmptyRes();
    {
        const vec2 mp = unpackHalf2x16(own.m_phat);
        if (own.light != NoLight && own.light < LightCount() && mp.x > 0.0) {
            r.light = own.light;
            r.p_hat = mp.y;
            r.m = mp.x;
            r.w_sum = own.weight * mp.x * mp.y;
        }
    }
    const uint taps = SpatialTaps();
    const float radius = 16.0;
    for (uint t = 0u; t < taps; ++t) {
        const float a = Rand(seed) * 6.2831853;
        const float d = sqrt(Rand(seed)) * radius;
        const ivec2 tap = pixel + ivec2(floor(vec2(cos(a), sin(a)) * d + 0.5));
        if (all(equal(tap, pixel)) || any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, ivec2(size)))) {
            continue;
        }
        const Reservoir h = res_in[PixelIndex(tap)];
        float hm, hp;
        if (!Similar(h, p.z, s.n, hm, hp) || h.light >= LightCount()) {
            continue;
        }
        ResMerge(r, h.light, h.weight, hm, TargetPdf(h.light, s), Rand(seed));
    }
    vec3 diffuse = vec3(0.0), specular = vec3(0.0);
    float W = ResWeight(r);
    if (r.light != NoLight && W > 0.0) {
        vec3 ld, ls;
        if (ShadeLight(r.light, s, ld, ls)) {
            const float far_w = FarWeight(s.p);
            const float vis = far_w > 0.0 ? mix(1.0, LightVisibility(r.light, s), far_w) : 1.0;
            if (vis <= 0.0) {
                r.w_sum = 0.0;
            }
            diffuse = ld * (W * vis);
            specular = ls * (W * vis);
        } else {
            r.w_sum = 0.0;
        }
    }
    res_out[index] = Pack(r, p.z, s.n);
    DirectionalSets(s, g3, pixel, diffuse, specular);
    WriteResult(pixel, diffuse, specular);
#endif
}
