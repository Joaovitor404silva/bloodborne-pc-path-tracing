float TargetPdf(uint light, Surface s) {
    vec3 ld, ls;
    if (light == NoLight || light >= LightCount() || !ShadeLight(light, s, ld, ls)) {
        return 0.0;
    }
    const float v = Luma(ld + ls);
    return (isnan(v) || isinf(v)) ? 0.0 : max(v, 0.0);
}

uint PackNormal(vec3 n) {
    const vec3 a = n / (abs(n.x) + abs(n.y) + abs(n.z) + 1e-8);
    const vec2 o = a.z >= 0.0 ? a.xy : (1.0 - abs(a.yx)) * vec2(a.x >= 0.0 ? 1.0 : -1.0, a.y >= 0.0 ? 1.0 : -1.0);
    const uvec2 q = uvec2(clamp(o * 0.5 + 0.5, 0.0, 1.0) * 255.0 + 0.5);
    return q.x | (q.y << 8u);
}

vec3 UnpackNormal(uint packed) {
    const vec2 o = vec2(float(packed & 0xFFu), float((packed >> 8u) & 0xFFu)) / 255.0 * 2.0 - 1.0;
    vec3 n = vec3(o, 1.0 - abs(o.x) - abs(o.y));
    if (n.z < 0.0) {
        n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(n);
}

struct Res {
    uint light;
    float w_sum;
    float m;
    float p_hat;
};

Res EmptyRes() {
    return Res(NoLight, 0.0, 0.0, 0.0);
}

void ResUpdate(inout Res r, uint light, float w, float p_hat, float u) {
    r.w_sum += w;
    r.m += 1.0;
    if (w > 0.0 && u * r.w_sum < w) {
        r.light = light;
        r.p_hat = p_hat;
    }
}

void ResMerge(inout Res r, uint light, float weight, float m, float p_hat_here, float u) {
    const float w = p_hat_here * weight * m;
    r.w_sum += w;
    r.m += m;
    if (w > 0.0 && u * r.w_sum < w) {
        r.light = light;
        r.p_hat = p_hat_here;
    }
}

float ResWeight(Res r) {
    return (r.p_hat > 0.0 && r.m > 0.0) ? r.w_sum / (r.m * r.p_hat) : 0.0;
}

Reservoir Pack(Res r, float z, vec3 n) {
    Reservoir out_r;
    out_r.light = r.light;
    out_r.weight = ResWeight(r);
    out_r.m_phat = packHalf2x16(vec2(min(r.m, 65504.0), min(r.p_hat, 65504.0)));
    out_r.z_normal = (packHalf2x16(vec2(min(abs(z), 65504.0), 0.0)) & 0xFFFFu) | (PackNormal(n) << 16u);
    return out_r;
}

bool Similar(Reservoir r, float z, vec3 n, out float m, out float p_hat) {
    const vec2 mp = unpackHalf2x16(r.m_phat);
    m = mp.x;
    p_hat = mp.y;
    const float rz = unpackHalf2x16(r.z_normal & 0xFFFFu).x;
    const vec3 rn = UnpackNormal(r.z_normal >> 16u);
    return r.light != NoLight && m > 0.0 && abs(abs(z) - rz) <= 0.05 * abs(z) + 0.02 && dot(rn, n) > 0.9;
}

uint PixelIndex(ivec2 pixel) {
    return uint(pixel.y) * uint(Size().x) + uint(pixel.x);
}
