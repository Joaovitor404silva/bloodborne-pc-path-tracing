#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer TlasSpace {
    vec4 tlas_rows[3];
};

TlasSpace TlasSpaceOf(uvec2 tlas) {
    return TlasSpace(uvec2(tlas.x - 256u, tlas.y - (tlas.x < 256u ? 1u : 0u)));
}

vec3 TlasPoint(uvec2 tlas, vec3 p) {
    TlasSpace s = TlasSpaceOf(tlas);
    return vec3(dot(s.tlas_rows[0], vec4(p, 1.0)), dot(s.tlas_rows[1], vec4(p, 1.0)),
                dot(s.tlas_rows[2], vec4(p, 1.0)));
}

vec3 TlasDir(uvec2 tlas, vec3 d) {
    TlasSpace s = TlasSpaceOf(tlas);
    return vec3(dot(s.tlas_rows[0].xyz, d), dot(s.tlas_rows[1].xyz, d), dot(s.tlas_rows[2].xyz, d));
}

mat3 TlasToView(uvec2 tlas, mat3 m) {
    TlasSpace s = TlasSpaceOf(tlas);
    return mat3(s.tlas_rows[0].xyz, s.tlas_rows[1].xyz, s.tlas_rows[2].xyz) * m;
}

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex;
layout(binding = 1) uniform texture2D normal_tex;
layout(binding = 2, std140) uniform Params {
    vec4 proj;
    vec4 prev_proj;
    vec4 reproject[3];
    vec4 unproject[3];
    vec4 size_jitter;
    vec4 prev_jitter_bias_gap;
    uvec4 tlas_frame_flags;
    uvec4 cfg;
    vec4 misc;
};
layout(binding = 3) uniform texture2D in_pos_tex;
layout(binding = 4) uniform texture2D in_rad_tex;
layout(binding = 5) uniform texture2D in_norm_tex;
layout(binding = 6) uniform texture2D in_recv_tex;
layout(binding = 7) uniform texture2D init_pos_tex;
layout(binding = 8) uniform texture2D init_rad_tex;
layout(binding = 9) uniform texture2D init_norm_tex;
layout(binding = 10) uniform texture2D init_recv_tex;
layout(binding = 11, rgba32f) uniform writeonly image2D out_pos;
layout(binding = 12, rgba16f) uniform writeonly image2D out_rad;
layout(binding = 13, rgba16f) uniform writeonly image2D out_norm;
layout(binding = 14, rgba16f) uniform writeonly image2D out_recv;
struct SurfaceRecord {
    uint texture;
    uint flags;
    uint uv_base;
    float alpha_ref;
};
layout(binding = 15, std430) readonly buffer Surfaces {
    SurfaceRecord surfaces[];
};
layout(binding = 16, std430) readonly buffer UvPool {
    uint uv_pool[];
};
const uint MaxSurfaceTextures = 1024u;
layout(set = 1, binding = 0) uniform sampler2D surface_textures[MaxSurfaceTextures];
const uint SurfaceAlphaTest = 1u;
const uint SurfaceUsable = 6u;
const uint TriangleWords = 8u;

uint SurfaceAlphaTexture(SurfaceRecord r) {
    const uint slot = (r.flags >> 6u) & 1023u;
    return slot != 0u ? slot : r.texture;
}

uint SurfaceAlphaChannel(SurfaceRecord r) {
    return ((r.flags >> 26u) & 3u) ^ 3u;
}

bool AlphaTestPasses(uint instance, uint primitive, vec2 barycentrics) {
    if (instance >= surfaces.length()) {
        return true;
    }
    const SurfaceRecord r = surfaces[instance];
    const uint alpha_tex = SurfaceAlphaTexture(r);
    if ((r.flags & SurfaceAlphaTest) == 0u || (r.flags & 2u) == 0u ||
        alpha_tex == 0u || alpha_tex >= MaxSurfaceTextures) {
        return true;
    }
    const uint base = r.uv_base + primitive * TriangleWords;
    if (base + 2u >= uv_pool.length()) {
        return true;
    }
    const vec2 a = unpackHalf2x16(uv_pool[base]);
    const vec2 b = unpackHalf2x16(uv_pool[base + 1u]);
    const vec2 c = unpackHalf2x16(uv_pool[base + 2u]);
    const vec2 uv = a * (1.0 - barycentrics.x - barycentrics.y) + b * barycentrics.x + c * barycentrics.y;
    const float alpha = textureLod(surface_textures[nonuniformEXT(alpha_tex)], uv, 0.0)[SurfaceAlphaChannel(r)];
    return !(alpha < r.alpha_ref);
}

const uint FlagReset = 1u;
const float DepthTolerance = 0.1;
const float NormalTolerance = 0.9;
const float MaxW = 65504.0;
const float Pi = 3.14159265;

vec2 Size() { return size_jitter.xy; }
vec2 Jitter() { return size_jitter.zw; }
vec2 PrevJitter() { return prev_jitter_bias_gap.xy; }
float Bias() { return prev_jitter_bias_gap.z; }
float Gap() { return prev_jitter_bias_gap.w; }
uint Frame() { return tlas_frame_flags.z; }
uint Flags() { return tlas_frame_flags.w; }
float MClamp() { return float(cfg.x); }
float MaxAge() { return float(cfg.y); }
uint Neighbours() { return cfg.z; }
uint Pass() { return cfg.w; }
float Radius() { return misc.x; }
float JacobianMax() { return misc.y; }

struct Reservoir {
    vec3 position;
    vec3 normal;
    vec3 radiance;
    float w_sum;
    float M;
    float W;
    float age;
};

Reservoir Empty() {
    Reservoir r;
    r.position = vec3(0.0);
    r.normal = vec3(0.0);
    r.radiance = vec3(0.0);
    r.w_sum = 0.0;
    r.M = 0.0;
    r.W = 0.0;
    r.age = 0.0;
    return r;
}

uint Hash(uint x) {
    x ^= x >> 16u;
    x *= 0x7feb352du;
    x ^= x >> 15u;
    x *= 0x846ca68bu;
    x ^= x >> 16u;
    return x;
}

float Random(inout uint state) {
    state = Hash(state);
    return float(state & 0x00FFFFFFu) / 16777216.0;
}

bool Finite(vec3 v) {
    return !(any(isnan(v)) || any(isinf(v)));
}

float ViewZ(float depth) {
    return proj.w / min(depth - proj.z, -1e-8);
}

vec3 PixelToView(vec2 pixel, float depth) {
    const vec2 uv = (pixel + 0.5 - Jitter()) / Size();
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    const float z = ViewZ(depth);
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}

vec2 ViewToPixel(vec3 p, vec4 projection, vec2 jitter) {
    const float z = max(p.z, 1e-4);
    const vec2 ndc = vec2(p.x * projection.x, p.y * projection.y) / z;
    return vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5) * Size() + jitter - 0.5;
}

float DepthAt(ivec2 pixel) {
    return texelFetch(depth_tex, clamp(pixel, ivec2(0), ivec2(Size()) - 1), 0).r;
}

bool DepthValid(float depth) {
    return !(depth >= 1.0 || depth < 0.0 || isnan(depth));
}

vec3 Rotate(vec4 rows[3], vec3 v) {
    return vec3(dot(rows[0].xyz, v), dot(rows[1].xyz, v), dot(rows[2].xyz, v));
}

vec3 Apply(vec4 rows[3], vec3 p) {
    const vec4 h = vec4(p, 1.0);
    return vec3(dot(rows[0], h), dot(rows[1], h), dot(rows[2], h));
}

float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

float ReceiverCos(vec3 sample_pos, vec3 p, vec3 n) {
    const vec3 d = sample_pos - p;
    const float len = length(d);
    return len > 1e-6 ? max(dot(d, n) / len, 0.0) : 0.0;
}

float TargetPdf(vec3 radiance, vec3 sample_pos, vec3 p, vec3 n) {
    return Luma(radiance) * ReceiverCos(sample_pos, p, n);
}

float Jacobian(vec3 sample_pos, vec3 sample_normal, vec3 from_receiver, vec3 to_receiver) {
    const vec3 dq = from_receiver - sample_pos;
    const vec3 dr = to_receiver - sample_pos;
    const float lq2 = dot(dq, dq), lr2 = dot(dr, dr);
    if (lq2 <= 1e-12 || lr2 <= 1e-12) {
        return 0.0;
    }
    const float cos_q = dot(dq, sample_normal) / sqrt(lq2);
    const float cos_r = dot(dr, sample_normal) / sqrt(lr2);
    if (cos_q <= 1e-4 || cos_r <= 1e-4) {
        return 0.0;
    }
    return (cos_r / cos_q) * (lq2 / lr2);
}

bool Merge(inout Reservoir r, Reservoir candidate, float target_pdf, float u) {
    const float m = min(candidate.M, MClamp());
    if (m <= 0.0) {
        return false;
    }
    const float w = target_pdf * candidate.W * m;
    r.M += m;
    if (!(w > 0.0) || isnan(w) || isinf(w)) {
        return false;
    }
    r.w_sum += w;
    if (u * r.w_sum < w) {
        r.position = candidate.position;
        r.normal = candidate.normal;
        r.radiance = candidate.radiance;
        r.age = candidate.age;
        return true;
    }
    return false;
}

void Finalize(inout Reservoir r, float target_pdf) {
    if (r.M <= 0.0 || target_pdf <= 0.0 || r.w_sum <= 0.0) {
        r.W = 0.0;
        return;
    }
    r.W = min(r.w_sum / (r.M * target_pdf), MaxW);
}

Reservoir LoadIn(ivec2 pixel) {
    Reservoir r = Empty();
    const vec4 pos = texelFetch(in_pos_tex, pixel, 0);
    const vec4 rad = texelFetch(in_rad_tex, pixel, 0);
    const vec4 nrm = texelFetch(in_norm_tex, pixel, 0);
    if (pos.w <= 0.0 || !Finite(pos.xyz) || !Finite(rad.rgb) || isnan(rad.w) || isinf(rad.w)) {
        return r;
    }
    r.position = pos.xyz;
    r.M = pos.w;
    r.radiance = max(rad.rgb, vec3(0.0));
    r.W = max(rad.w, 0.0);
    r.normal = nrm.xyz;
    r.age = nrm.w;
    return r;
}

Reservoir LoadInit(ivec2 pixel) {
    Reservoir r = Empty();
    const vec4 pos = texelFetch(init_pos_tex, pixel, 0);
    const vec4 rad = texelFetch(init_rad_tex, pixel, 0);
    const vec4 nrm = texelFetch(init_norm_tex, pixel, 0);
    if (pos.w <= 0.0 || !Finite(pos.xyz) || !Finite(rad.rgb) || isnan(rad.w) || isinf(rad.w)) {
        return r;
    }
    r.position = pos.xyz;
    r.M = pos.w;
    r.radiance = max(rad.rgb, vec3(0.0));
    r.W = max(rad.w, 0.0);
    r.normal = nrm.xyz;
    r.age = 0.0;
    return r;
}

void Store(ivec2 pixel, Reservoir r, vec3 n, float z) {
    if (!Finite(r.position) || !Finite(r.radiance) || isnan(r.W) || isinf(r.W)) {
        r = Empty();
    }
    imageStore(out_pos, pixel, vec4(r.position, r.M));
    imageStore(out_rad, pixel, vec4(r.radiance, r.W));
    imageStore(out_norm, pixel, vec4(r.normal, r.age));
    imageStore(out_recv, pixel, vec4(n, z));
}

const uint SurfaceGlassPane = 0x10000000u;
const uint MaskSolid = 0x01u;
const uint MaskPortal = 0x08u;
const float PortalWall = 1.5;

bool BlockedSpan(vec3 origin, vec3 dir, float t_min, float t_max) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_frame_flags.xy),
                          gl_RayFlagsTerminateOnFirstHitEXT, MaskSolid, TlasPoint(tlas_frame_flags.xy, origin), t_min, TlasDir(tlas_frame_flags.xy, dir), t_max);
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
            continue;
        }
        const uint instance = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false));
        if (instance < surfaces.length() && (surfaces[instance].flags & SurfaceGlassPane) != 0u) {
            continue;
        }
        if (AlphaTestPasses(instance, uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false)),
                            rayQueryGetIntersectionBarycentricsEXT(q, false))) {
            rayQueryConfirmIntersectionEXT(q);
        }
    }
    return rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
}

bool Blocked(vec3 origin, vec3 dir, float t_max) {
    rayQueryEXT p;
    rayQueryInitializeEXT(p, accelerationStructureEXT(tlas_frame_flags.xy), gl_RayFlagsOpaqueEXT,
                          MaskPortal, TlasPoint(tlas_frame_flags.xy, origin), 0.0, TlasDir(tlas_frame_flags.xy, dir), t_max);
    while (rayQueryProceedEXT(p)) {
    }
    if (rayQueryGetIntersectionTypeEXT(p, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        const float t_pane = rayQueryGetIntersectionTEXT(p, true);
        return BlockedSpan(origin, dir, 0.0, t_pane) ||
               (t_pane + PortalWall < t_max && BlockedSpan(origin, dir, t_pane + PortalWall, t_max));
    }
    return BlockedSpan(origin, dir, 0.0, t_max);
}

bool SimilarSurface(float z, vec3 n, float other_z, vec3 other_n) {
    return other_z > 0.0 && abs(z - other_z) <= DepthTolerance * z + 0.02 &&
           dot(n, other_n) >= NormalTolerance;
}

#ifdef RT_RESTIR_SPATIAL
void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const vec2 size = Size();
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    const float depth = DepthAt(pixel);
    const vec4 recv = texelFetch(in_recv_tex, pixel, 0);
    const vec3 n = recv.xyz;
    if (!DepthValid(depth) || dot(n, n) < 0.5) {
        Store(pixel, Empty(), vec3(0.0), 0.0);
        return;
    }
    const vec3 p = PixelToView(vec2(pixel), depth);
    uint state = Hash(uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + Frame() * 26699u +
                      Pass() * 7919u + 4099u);
    Reservoir center = LoadIn(pixel);
    Reservoir r = Empty();
    r.position = center.position;
    r.normal = center.normal;
    r.radiance = center.radiance;
    r.age = center.age;
    r.M = center.M;
    const float center_pdf = TargetPdf(center.radiance, center.position, p, n);
    r.w_sum = center.M > 0.0 ? center_pdf * center.W * center.M : 0.0;
    bool from_neighbour = false;
    const uint count = Neighbours();
    for (uint k = 0u; k < count; ++k) {
        const float u1 = Random(state), u2 = Random(state);
        const float radius = Radius() * sqrt(u1);
        const float phi = 6.28318530718 * u2;
        const ivec2 q = pixel + ivec2(floor(vec2(cos(phi), sin(phi)) * radius + 0.5));
        if (all(equal(q, pixel)) || any(lessThan(q, ivec2(0))) ||
            any(greaterThanEqual(q, ivec2(size)))) {
            continue;
        }
        const float q_depth = DepthAt(q);
        const vec4 q_recv = texelFetch(in_recv_tex, q, 0);
        if (!DepthValid(q_depth) || !SimilarSurface(p.z, n, q_recv.w, q_recv.xyz)) {
            continue;
        }
        const Reservoir rq = LoadIn(q);
        if (rq.M <= 0.0) {
            continue;
        }
        const vec3 pq = PixelToView(vec2(q), q_depth);
        const float jacobian = Jacobian(rq.position, rq.normal, pq, p);
        if (!(jacobian > 0.0) || (JacobianMax() > 0.0 && jacobian > JacobianMax())) {
            continue;
        }
        const float target = TargetPdf(rq.radiance, rq.position, p, n) * jacobian;
        if (Merge(r, rq, target, Random(state))) {
            from_neighbour = true;
        }
    }
    float target = TargetPdf(r.radiance, r.position, p, n);
    if (from_neighbour && target > 0.0) {
        const vec3 origin = p + n * (Bias() + abs(p.z) * 2e-4);
        const vec3 d = r.position - origin;
        const float len = length(d);
        if (len > 1e-3 && Blocked(origin, d / len, max(len - Gap(), 1e-3))) {
            target = 0.0;
        }
    }
    Finalize(r, target);
    Store(pixel, r, n, p.z);
}
#else
void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const vec2 size = Size();
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    const float depth = DepthAt(pixel);
    const vec4 recv = texelFetch(init_recv_tex, pixel, 0);
    const vec3 n = recv.xyz;
    if (!DepthValid(depth) || dot(n, n) < 0.5) {
        Store(pixel, Empty(), vec3(0.0), 0.0);
        return;
    }
    const vec3 p = PixelToView(vec2(pixel), depth);
    uint state = Hash(uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + Frame() * 26699u + 1033u);
    Reservoir r = Empty();
    const Reservoir init = LoadInit(pixel);
    Merge(r, init, TargetPdf(init.radiance, init.position, p, n), Random(state));
    if ((Flags() & FlagReset) == 0u) {
        const vec3 prev = Apply(reproject, p);
        if (prev.z > 1e-4) {
            const vec2 prev_pixel = ViewToPixel(prev, prev_proj, PrevJitter());
            const ivec2 tap = ivec2(floor(prev_pixel + 0.5));
            if (all(greaterThanEqual(tap, ivec2(0))) && all(lessThan(tap, ivec2(size)))) {
                const vec4 stored = texelFetch(in_recv_tex, tap, 0);
                const vec3 n_prev = Rotate(reproject, n);
                if (SimilarSurface(prev.z, n_prev, stored.w, stored.xyz)) {
                    Reservoir hist = LoadIn(tap);
                    if (hist.M > 0.0 && hist.age < MaxAge()) {
                        hist.position = Apply(unproject, hist.position);
                        hist.normal = Rotate(unproject, hist.normal);
                        hist.age += 1.0;
                        Merge(r, hist, TargetPdf(hist.radiance, hist.position, p, n), Random(state));
                    }
                }
            }
        }
    }
    Finalize(r, TargetPdf(r.radiance, r.position, p, n));
    Store(pixel, r, n, p.z);
}
#endif
