#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 64) in;

struct DrawRecord {
    uint triangle_base;
    uint triangle_count;
    uint store_base;
    uint index_lo;
    uint vertex_count;
    uint prims_per_instance;
    uint index_offset;
    uint flags;
    uint uv_base;
    uint pad0;
    uint pad1;
    uint pad2;
    vec4 rebase[3];
};

layout(binding = 0, std430) readonly buffer Records { DrawRecord records[]; };
layout(binding = 1, std430) readonly buffer Indices { uint index_words[]; };
layout(binding = 2, std430) writeonly buffer Soup { float soup[]; };
layout(binding = 3, std430) writeonly buffer UvPool { uint uv_pool[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Uvs {
    uint packed[];
};
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Positions {
    vec4 clip[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Normals {
    uvec2 packed[];
};

layout(push_constant) uniform Constants {
    uvec2 positions_address;
    uint record_count;
    uint triangle_count;
    vec2 proj_scale;
    uvec2 uvs_address;
    uvec2 normals_address;
    uvec2 pad;
    vec4 view_rows[3];
};

vec3 ToView(vec3 w) {
    return vec3(dot(view_rows[0].xyz, w), dot(view_rows[1].xyz, w), dot(view_rows[2].xyz, w));
}

vec3 Rebase(DrawRecord r, vec3 v, float w) {
    return vec3(dot(r.rebase[0].xyz, v) + r.rebase[0].w * w, dot(r.rebase[1].xyz, v) + r.rebase[1].w * w,
                dot(r.rebase[2].xyz, v) + r.rebase[2].w * w);
}

uint PickNormal(DrawRecord r, uvec2 packed, vec3 flat_n) {
    const vec3 a = unpackSnorm4x8(packed.x).xyz;
    const vec3 b = unpackSnorm4x8(packed.y).xyz;
    vec3 best = vec3(0.0);
    float best_dot = 0.5;
    vec3 c[4] = vec3[4](a, b, ToView(a), ToView(b));
    if ((r.flags & 32u) != 0u) {
        for (int i = 0; i < 4; ++i) {
            c[i] = Rebase(r, c[i], 0.0);
        }
    }
    for (int i = 0; i < 4; ++i) {
        if (dot(c[i], c[i]) < 1e-6) {
            continue;
        }
        const vec3 n = normalize(c[i]);
        const float d = dot(n, flat_n);
        if (abs(d) > best_dot) {
            best_dot = abs(d);
            best = d < 0.0 ? -n : n;
        }
    }
    return dot(best, best) > 0.5 ? packSnorm4x8(vec4(best, 0.0)) : 0u;
}

uint TangentWord(vec3 v0, vec3 v1, vec3 v2, vec2 uv0, vec2 uv1, vec2 uv2, vec3 n) {
    const vec3 e1 = v1 - v0;
    const vec3 e2 = v2 - v0;
    const vec2 d1 = uv1 - uv0;
    const vec2 d2 = uv2 - uv0;
    const float det = d1.x * d2.y - d2.x * d1.y;
    if (abs(det) < 1e-12) {
        return 0u;
    }
    const float inv = 1.0 / det;
    vec3 t = (e1 * d2.y - e2 * d1.y) * inv;
    const vec3 bt = (e2 * d1.x - e1 * d2.x) * inv;
    t -= n * dot(t, n);
    if (dot(t, t) < 1e-12) {
        return 0u;
    }
    t = normalize(t);
    const float hand = dot(cross(n, t), bt) < 0.0 ? -1.0 : 1.0;
    return packSnorm4x8(vec4(t, hand));
}

uint FetchIndex(DrawRecord r, uint i) {
    if ((r.flags & 1u) != 0u) {
        const uint byte = r.index_offset + i * 2u;
        const uint word = index_words[byte >> 2u];
        return (word >> ((byte & 2u) * 8u)) & 0xFFFFu;
    }
    if ((r.flags & 2u) != 0u) {
        return index_words[(r.index_offset >> 2u) + i];
    }
    return i;
}

void main() {
    const uint t = gl_GlobalInvocationID.x;
    if (t >= triangle_count) {
        return;
    }
    uint lo = 0u, hi = record_count;
    while (hi - lo > 1u) {
        const uint mid = (lo + hi) / 2u;
        if (records[mid].triangle_base <= t) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    const DrawRecord r = records[lo];
    const uint local = t - r.triangle_base;
    const uint inst = local / r.prims_per_instance;
    const uint prim = local - inst * r.prims_per_instance;
    const uint marker = (r.flags & 1u) != 0u ? 0xFFFFu : 0xFFFFFFFFu;
    Positions positions = Positions(positions_address);
    vec3 v[3];
    uint uv[3] = uint[3](0u, 0u, 0u);
    uvec2 vn[3] = uvec2[3](uvec2(0u), uvec2(0u), uvec2(0u));
    const bool want_region = r.uv_base != 0xFFFFFFFFu;
    const bool want_uv = want_region && (r.flags & 8u) != 0u && (uvs_address.x | uvs_address.y) != 0u;
    const bool want_normal = want_region && (r.flags & 16u) != 0u &&
                             (normals_address.x | normals_address.y) != 0u;
    Uvs uvs = Uvs(uvs_address);
    Normals normals = Normals(normals_address);
    bool ok = local < r.triangle_count;
    for (int k = 0; k < 3 && ok; ++k) {
        const uint idx = FetchIndex(r, prim * 3u + uint(k));
        if (((r.flags & 4u) != 0u && idx == marker) || idx < r.index_lo ||
            idx - r.index_lo >= r.vertex_count) {
            ok = false;
            break;
        }
        const uint slot = r.store_base + inst * r.vertex_count + (idx - r.index_lo);
        const vec4 c = positions.clip[slot];
        if (want_uv) {
            uv[k] = uvs.packed[slot];
        }
        if (want_normal) {
            vn[k] = normals.packed[slot];
        }
        v[k] = vec3(c.x / proj_scale.x, c.y / proj_scale.y, c.w);
        if ((r.flags & 32u) != 0u) {
            v[k] = Rebase(r, v[k], 1.0);
        }
        if (any(isnan(v[k])) || any(isinf(v[k]))) {
            ok = false;
        }
    }
    const float nan = uintBitsToFloat(0x7FC00000u);
    for (int k = 0; k < 3; ++k) {
        for (int j = 0; j < 3; ++j) {
            soup[t * 9u + uint(k) * 3u + uint(j)] = ok ? v[k][j] : nan;
        }
    }
    if (want_region) {
        const uint base = r.uv_base + local * 8u;
        for (int k = 0; k < 3; ++k) {
            uv_pool[base + uint(k)] = ok && want_uv ? uv[k] : 0u;
        }
        vec3 n = ok ? cross(v[1] - v[0], v[2] - v[0]) : vec3(0.0);
        n = dot(n, n) > 0.0 ? normalize(n) : vec3(0.0);
        uv_pool[base + 3u] = packSnorm4x8(vec4(n, 0.0));
        const bool flat_ok = ok && dot(n, n) > 0.5;
        for (int k = 0; k < 3; ++k) {
            uv_pool[base + 4u + uint(k)] = flat_ok && want_normal ? PickNormal(r, vn[k], n) : 0u;
        }
        uv_pool[base + 7u] = flat_ok && want_uv
                                 ? TangentWord(v[0], v[1], v[2], unpackHalf2x16(uv[0]),
                                               unpackHalf2x16(uv[1]), unpackHalf2x16(uv[2]), n)
                                 : 0u;
    }
}
