#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer TlasSpace {
    vec4 tlas_rows[3];
};

TlasSpace TlasSpaceOf(uvec2 tlas) {
    return TlasSpace(uvec2(tlas.x - 256u, tlas.y - (tlas.x < 256u ? 1u : 0u)));
}

vec3 TlasPoint(uvec2 tlas, vec3 p) {
    TlasSpace s = TlasSpaceOf(tlas);
    return vec3(dot(s.tlas_rows[0], vec4(p, 1.0)), dot(s.tlas_rows[1], vec4(p, 1.0)),
                dot(s.tlas_rows[2], vec4(p, 1.0)));
}

vec3 TlasDir(uvec2 tlas, vec3 d) {
    TlasSpace s = TlasSpaceOf(tlas);
    return vec3(dot(s.tlas_rows[0].xyz, d), dot(s.tlas_rows[1].xyz, d), dot(s.tlas_rows[2].xyz, d));
}

mat3 TlasToView(uvec2 tlas, mat3 m) {
    TlasSpace s = TlasSpaceOf(tlas);
    return mat3(s.tlas_rows[0].xyz, s.tlas_rows[1].xyz, s.tlas_rows[2].xyz) * m;
}

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex;
layout(binding = 1, rgba16f) uniform image2D scene_img;
layout(binding = 2, rgba16f) uniform image2D fog_out;
layout(binding = 3) uniform texture2D fog_prev;

layout(binding = 4, std140) uniform Params {
    vec4 proj;
    vec4 view_rows[3];
    vec4 size_jitter;
    uvec4 tlas_count_flags;
    uvec4 cfg;
    vec4 fog;
    vec4 prev_proj;
    vec4 reproject[3];
    vec4 prev_jitter;
    vec4 moon;
    uvec4 light_cfg;
    vec4 pick; // xy pick pixel, z > 0.5 when the pick is on, w sun share (BB_RT_FX_FOG_SUN_SHARE)
};

layout(binding = 5, std430) readonly buffer DirSets {
    vec4 sets[];
};

const uint FlagSets = 1u;
const uint FlagHistory = 2u;
const uint FlagTable = 4u;
const uint Scale = 4u;

layout(binding = 9) uniform texture2D g3_tex;
layout(binding = 10, std430) readonly buffer FogSets {
    vec4 fog_sets[];
};

#ifndef RT_FOG_APPLY
