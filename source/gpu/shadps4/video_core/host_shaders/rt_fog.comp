vec2 Size() { return size_jitter.xy; }
vec2 Jitter() { return size_jitter.zw; }
uint Frame() { return cfg.x; }
uint Steps() { return max(cfg.y, 1u); }
uint Debug() { return cfg.z; }
float AlphaDistance() { return max(uintBitsToFloat(cfg.w), 0.06); }
uint Flags() { return tlas_count_flags.w; }
// Window shaft medium (BB_RT_FX_FOG_SHAFT): extinction per metre of a thin indoor haze that is
// lit only by moonlight coming in through painted windows (portal panes).
float ShaftDensity() { return fog.x; }
float HeightFalloff() { return fog.y; }
float Strength() { return fog.z; }
float MaxDistance() { return fog.w; }
uint TableVec4s() { return uint(prev_jitter.w + 0.5); }
uint LampCount() { return light_cfg.x; }
uint SkySlotId() { return light_cfg.y; }
uint LightFlags() { return light_cfg.z; }
float SkyClamp() { return max(uintBitsToFloat(light_cfg.w), 0.0); }
float SkyScale() { return moon.y; }
float LampScale() { return moon.z; }
float SunShare() { return pick.w; }
const uint LightLamps = 1u;
const uint LightSky = 2u;
// The sky pass saw the game's dome this frame (rt_sky.comp): dome pixels get no traced fog.
const uint LightDome = 4u;
// Calibrate the fog albedo against all the light the fog receives (sky and sun), not the sky alone.
const uint LightSunCal = 8u;
// Portal panes (painted windows, rt_surface.h SurfacePortal) are in the TLAS this frame.
const uint LightPortals = 16u;
const uint MaskPortal = 0x08u; // rt_geometry.h MaskPortal
const float PortalWall = 1.5; // rt_direct.comp PortalWall
const float Pi = 3.14159265;

bool FogSetAt(uint id, out vec4 dist, out vec4 col, out vec4 height, out vec4 hcol) {
    dist = vec4(0.0);
    col = vec4(0.0);
    height = vec4(0.0);
    hcol = vec4(0.0);
    if ((Flags() & FlagTable) == 0u) {
        return false;
    }
    const uint base = id * 6u;
    if (base + 5u >= TableVec4s()) {
        return false;
    }
    col = fog_sets[base + 1u];
    dist = fog_sets[base + 2u];
    height = fog_sets[base + 3u];
    hcol = fog_sets[base + 4u];
    return true;
}

float Transmittance(float s, vec4 dist) {
    return exp2(-max(s - dist.y, 0.0) * max(dist.z, 0.0));
}

vec3 WorldDir(vec3 v) {
    return view_rows[0].xyz * v.x + view_rows[1].xyz * v.y + view_rows[2].xyz * v.z;
}

float ViewZ(float depth) {
    return proj.w / min(depth - proj.z, -1e-8);
}

vec3 PixelToView(vec2 pixel, float depth) {
    const vec2 uv = (pixel + 0.5 - Jitter()) / Size();
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    const float z = ViewZ(depth);
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}

vec2 ViewToPixel(vec3 p, vec4 projection, vec2 jitter) {
    const vec2 ndc = vec2(p.x * projection.x, p.y * projection.y) / p.z;
    return vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5) * Size() + jitter - 0.5;
}

float DepthAt(ivec2 pixel) {
    return texelFetch(depth_tex, clamp(pixel, ivec2(0), ivec2(Size()) - 1), 0).r;
}

uint Hash(uint x) {
    x ^= x >> 16u;
    x *= 0x7feb352du;
    x ^= x >> 15u;
    x *= 0x846ca68bu;
    x ^= x >> 16u;
    return x;
}

float Rand(uvec2 pixel, uint salt) {
    return float(Hash(pixel.x * 1973u + pixel.y * 9277u + salt * 26699u + Frame() * 7919u) & 0xFFFFFFu) /
           16777216.0;
}

#if !defined(RT_FOG_APPLY) && !defined(RT_FOG_OPAQUE)

struct SurfaceRecord {
    uint texture;
    uint flags;
    uint uv_base;
    float alpha_ref;
};

layout(binding = 7, std430) readonly buffer Surfaces {
    SurfaceRecord surfaces[];
};

layout(binding = 8, std430) readonly buffer UvPool {
    uint uv_pool[];
};

const uint MaxSurfaceTextures = 1024u;
layout(set = 1, binding = 0) uniform sampler2D surface_textures[MaxSurfaceTextures];

const uint SurfaceAlphaTest = 1u;
const uint SurfaceHasUv = 2u;
const uint SurfaceHasTexture = 4u;
const uint SurfaceBlended = 32u;
const uint SurfaceUsable = SurfaceHasUv | SurfaceHasTexture;
const uint TriangleWords = 8u;

uint SurfaceAlphaTexture(SurfaceRecord r) {
    const uint slot = (r.flags >> 6u) & 1023u;
    return slot != 0u ? slot : r.texture;
}

uint SurfaceAlphaChannel(SurfaceRecord r) {
    return ((r.flags >> 26u) & 3u) ^ 3u;
}

bool SurfaceTests(SurfaceRecord r) {
    const uint alpha_tex = SurfaceAlphaTexture(r);
    return (r.flags & SurfaceAlphaTest) != 0u && (r.flags & SurfaceHasUv) != 0u &&
           alpha_tex != 0u && alpha_tex < MaxSurfaceTextures;
}

float SurfaceAlpha(SurfaceRecord r, uint primitive, vec2 barycentrics) {
    const uint base = r.uv_base + primitive * TriangleWords;
    if (base + 2u >= uv_pool.length()) {
        return 1.0;
    }
    const vec2 a = unpackHalf2x16(uv_pool[base]);
    const vec2 b = unpackHalf2x16(uv_pool[base + 1u]);
    const vec2 c = unpackHalf2x16(uv_pool[base + 2u]);
    const vec2 uv = a * (1.0 - barycentrics.x - barycentrics.y) + b * barycentrics.x + c * barycentrics.y;
    return textureLod(surface_textures[nonuniformEXT(SurfaceAlphaTexture(r))], uv, 0.0)[SurfaceAlphaChannel(r)];
}

float Visibility(vec3 origin, vec3 dir, float far_t) {
    if (far_t <= 0.05) {
        return 1.0;
    }
    const float alpha_t = min(AlphaDistance(), far_t);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_count_flags.xy),
                          gl_RayFlagsTerminateOnFirstHitEXT, 0xEFu, TlasPoint(tlas_count_flags.xy, origin), 0.05, TlasDir(tlas_count_flags.xy, dir), alpha_t);
    float t = 1.0;
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
            continue;
        }
        const uint instance = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, false));
        if (instance >= surfaces.length()) {
            rayQueryConfirmIntersectionEXT(q);
            continue;
        }
        const SurfaceRecord r = surfaces[instance];
        const uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false));
        const vec2 b = rayQueryGetIntersectionBarycentricsEXT(q, false);
        if ((r.flags & SurfaceBlended) != 0u) {
            const float alpha = SurfaceTests(r) ? SurfaceAlpha(r, primitive, b) : 1.0;
            t *= 1.0 - clamp(alpha * prev_jitter.z, 0.0, 1.0);
            if (t < 0.02) {
                rayQueryConfirmIntersectionEXT(q);
            }
        } else if (!SurfaceTests(r) || !(SurfaceAlpha(r, primitive, b) < r.alpha_ref)) {
            rayQueryConfirmIntersectionEXT(q);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        return 0.0;
    }
    if (far_t <= alpha_t) {
        return t;
    }
    rayQueryEXT far;
    rayQueryInitializeEXT(far, accelerationStructureEXT(tlas_count_flags.xy),
                          gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0x01u, TlasPoint(tlas_count_flags.xy, origin),
                          alpha_t, TlasDir(tlas_count_flags.xy, dir), far_t);
    while (rayQueryProceedEXT(far)) {
    }
    return rayQueryGetIntersectionTypeEXT(far, true) == gl_RayQueryCommittedIntersectionTriangleEXT
               ? 0.0
               : t;
}

// 1 when the closest hit toward the light is a portal pane: the light reaches this point
// through a painted window. Open sky (no hit) gives 0, the table fog already lights that.
// The panes have their own mask bit (rt_geometry.h MaskPortal): the nearest pane first, then
// any solid hit in front of it, then past the wall behind it (PortalWall) out to the light.
float PortalVisibility(vec3 origin, vec3 dir) {
    rayQueryEXT p;
    rayQueryInitializeEXT(p, accelerationStructureEXT(tlas_count_flags.xy), gl_RayFlagsOpaqueEXT,
                          MaskPortal, TlasPoint(tlas_count_flags.xy, origin), 0.05, TlasDir(tlas_count_flags.xy, dir), 1.0e4);
    while (rayQueryProceedEXT(p)) {
    }
    if (rayQueryGetIntersectionTypeEXT(p, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
        return 0.0;
    }
    const float t_pane = rayQueryGetIntersectionTEXT(p, true);
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_count_flags.xy),
                          gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0x05u, TlasPoint(tlas_count_flags.xy, origin),
                          0.05, TlasDir(tlas_count_flags.xy, dir), t_pane);
    while (rayQueryProceedEXT(q)) {
    }
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        return 0.0;
    }
    rayQueryEXT far;
    rayQueryInitializeEXT(far, accelerationStructureEXT(tlas_count_flags.xy),
                          gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0x05u, TlasPoint(tlas_count_flags.xy, origin),
                          t_pane + PortalWall, TlasDir(tlas_count_flags.xy, dir), 1.0e4);
    while (rayQueryProceedEXT(far)) {
    }
    return rayQueryGetIntersectionTypeEXT(far, true) == gl_RayQueryCommittedIntersectionTriangleEXT ? 0.0 : 1.0;
}

