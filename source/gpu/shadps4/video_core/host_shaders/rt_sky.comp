#version 460
#extension GL_EXT_samplerless_texture_functions : require

// Sky dome as a light (full path tracing plan item 3). The game draws its sky dome (ps dda49e89,
// a 2048x512 panorama on a squashed hemisphere) after the lighting composite, so the GI pass only
// ever saw the grey pre-sky fill. This pass runs at the post trigger, after the sky draw. It fits
// one gain per channel between the dome texture and the sky pixels on screen (the game multiplies
// the texture by its own sky colour and adds fog), then writes dome x gain into every cell of the
// 32x32 octahedral sky probe and into the sky mean. GI misses and fog in-scatter read the probe,
// so all sky light comes from the game's own sky image.
//
// Phase 0 (cfg.z == 0): one workgroup fits the gain and fills the probe.
// Phase 1 (cfg.z == 1): one thread per pixel, debug views over the sky pixels (BB_RT_SKY_DEBUG).

layout(local_size_x = 256) in;

layout(binding = 0) uniform texture2D depth_tex;
layout(binding = 1, rgba16f) uniform image2D scene_img;
layout(binding = 2) uniform sampler2D dome_tex;
layout(binding = 3, std430) buffer Material {
    vec4 material[];
};

layout(push_constant) uniform Push {
    vec4 view_rows[3];
    vec4 proj;
    vec4 size_jitter;
    uvec4 cfg;
    vec4 dome;
};

const uint SkyProbeSize = 32u;
const uint Cells = SkyProbeSize * SkyProbeSize;
const float Pi = 3.14159265;
const float Blend = 0.125;
const float MaxFrames = 64.0;
const uint GridX = 64u;
const uint GridY = 36u;
const uint MinSamples = 24u;

uint SkySlot() { return cfg.x; }
uint Debug() { return cfg.y; }
uint Phase() { return cfg.z; }
vec2 Size() { return size_jitter.xy; }
vec2 Jitter() { return size_jitter.zw; }
float UOffset() { return dome.x; }
float URepeat() { return dome.y; }
float VDivisor() { return dome.z; }
float SkyClamp() { return dome.w; }
uint ProbeBase() { return 2u * SkySlot() + 1u; }
uint GainSlot() { return ProbeBase() + Cells; }
const uint SkyImageSize = 1024u; // rt_gi.h SkyImageSize
uint ImageBase() { return GainSlot() + 2u; }

bool Finite(vec3 v) {
    return !any(isnan(v)) && !any(isinf(v));
}

vec3 WorldDir(vec3 v) {
    return view_rows[0].xyz * v.x + view_rows[1].xyz * v.y + view_rows[2].xyz * v.z;
}

vec3 PixelWorldDir(vec2 pixel) {
    const vec2 uv = (pixel + 0.5 - Jitter()) / Size();
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    return normalize(WorldDir(vec3(ndc.x / proj.x, ndc.y / proj.y, 1.0)));
}

vec2 OctEncode(vec3 d) {
    const float l1 = abs(d.x) + abs(d.y) + abs(d.z);
    if (!(l1 > 0.0)) {
        return vec2(0.5);
    }
    vec2 p = d.xy / l1;
    if (d.z < 0.0) {
        p = (1.0 - abs(p.yx)) * vec2(p.x >= 0.0 ? 1.0 : -1.0, p.y >= 0.0 ? 1.0 : -1.0);
    }
    return p * 0.5 + 0.5;
}

vec3 OctDecode(vec2 e) {
    const vec2 p = e * 2.0 - 1.0;
    vec3 d = vec3(p, 1.0 - abs(p.x) - abs(p.y));
    if (d.z < 0.0) {
        d.xy = (1.0 - abs(d.yx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(d);
}

// Dome texture v (in the vertex format's 16-bit units) against elevation from the dome centre,
// read from the dome mesh (ps dda49e89 draw 1, 33-vertex rings).
const int Rows = 11;
const float RowElev[Rows] = float[](-2.9, 1.8, 6.8, 12.4, 19.2, 28.3, 41.4, 56.0, 80.8, 85.8, 90.0);
const float RowV[Rows] = float[](2044.0, 1780.0, 1501.0, 1211.0, 892.0, 572.0, 337.0, 176.0, 79.0,
                                 14.0, 0.0);

float ElevationToV(float elev) {
    if (elev <= RowElev[0]) {
        return RowV[0];
    }
    for (int i = 1; i < Rows; ++i) {
        if (elev <= RowElev[i]) {
            const float t = (elev - RowElev[i - 1]) / (RowElev[i] - RowElev[i - 1]);
            return mix(RowV[i - 1], RowV[i], t);
        }
    }
    return 0.0;
}

vec2 DomeUv(vec3 w) {
    const float elev = degrees(asin(clamp(w.y, -1.0, 1.0)));
    const float phi = atan(w.z, w.x) / (2.0 * Pi);
    return vec2((UOffset() + phi) * URepeat(), ElevationToV(elev) / VDivisor());
}

vec3 Dome(vec3 w, float lod) {
    vec2 uv = DomeUv(w);
    uv.y = clamp(uv.y, 0.5 / 512.0, 1.0 - 0.5 / 512.0);
    const vec3 c = textureLod(dome_tex, uv, lod).rgb;
    return Finite(c) ? max(c, vec3(0.0)) : vec3(0.0);
}

// The dome mesh is a squashed hemisphere around the camera (horizon radius about 1480, top 539)
// and it writes depth, so after the sky draw the sky is not at depth 1. A pixel shows the sky if
// it is at depth 1 or beyond DomeFraction of the dome model's distance in its direction.
const float DomeRadius = 1480.0;
const float DomeHeight = 539.0;
// Measured in game: sky pixels sit at 0.4-0.8 of this model's range, scene geometry below 0.2.
const float DomeFraction = 0.3;

float DomeRange(vec3 w) {
    const float c = length(w.xz), s = max(w.y, 0.0);
    return inversesqrt(c * c / (DomeRadius * DomeRadius) + s * s / (DomeHeight * DomeHeight));
}

bool IsSky(ivec2 pixel, vec3 w) {
    const float depth = texelFetch(depth_tex, pixel, 0).r;
    if (depth >= 1.0) {
        return true;
    }
    const vec2 uv = (vec2(pixel) + 0.5 - Jitter()) / Size();
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    const float z = proj.w / min(depth - proj.z, -1e-8);
    const float range = z * length(vec3(ndc.x / proj.x, ndc.y / proj.y, 1.0));
    return range >= DomeFraction * DomeRange(w);
}

shared vec3 s_sd[256];
shared vec3 s_dd[256];
shared vec3 s_ss[256];
shared uint s_n[256];
// Screen sky per probe cell, fixed point (CellScale per unit), so the visible sky is learned
// exactly, clouds included; cells off screen take dome x gain.
const float CellScale = 1024.0;
shared uint s_cell[Cells * 4u];
shared vec3 s_gain;
shared bool s_gain_ok;

void FitAndFill() {
    const uint t = gl_LocalInvocationIndex;
    for (uint i = t; i < Cells * 4u; i += 256u) {
        s_cell[i] = 0u;
    }
    barrier();
    vec3 sd = vec3(0.0), dd = vec3(0.0), ss = vec3(0.0);
    uint n = 0u;
    for (uint i = t; i < GridX * GridY; i += 256u) {
        const vec2 cell = vec2(float(i % GridX) + 0.5, float(i / GridX) + 0.5);
        const ivec2 pixel = ivec2(cell / vec2(GridX, GridY) * Size());
        const vec3 w = PixelWorldDir(vec2(pixel));
        if (!Finite(w) || w.y < -0.05 || !IsSky(pixel, w)) {
            continue;
        }
        const vec3 s = imageLoad(scene_img, pixel).rgb;
        if (!Finite(s)) {
            continue;
        }
        const ivec2 oc = clamp(ivec2(OctEncode(w) * float(SkyProbeSize)), ivec2(0),
                               ivec2(int(SkyProbeSize) - 1));
        const uint cell_id = (uint(oc.y) * SkyProbeSize + uint(oc.x)) * 4u;
        const uvec3 q = uvec3(clamp(s, vec3(0.0), vec3(SkyClamp())) * CellScale + 0.5);
        atomicAdd(s_cell[cell_id + 0u], q.x);
        atomicAdd(s_cell[cell_id + 1u], q.y);
        atomicAdd(s_cell[cell_id + 2u], q.z);
        atomicAdd(s_cell[cell_id + 3u], 1u);
        const vec3 d = Dome(w, 0.0);
        sd += s * d;
        dd += d * d;
        ss += s * s;
        ++n;
    }
    s_sd[t] = sd;
    s_dd[t] = dd;
    s_ss[t] = ss;
    s_n[t] = n;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (t < stride) {
            s_sd[t] += s_sd[t + stride];
            s_dd[t] += s_dd[t + stride];
            s_ss[t] += s_ss[t + stride];
            s_n[t] += s_n[t + stride];
        }
        barrier();
    }
    if (t == 0u) {
        const vec4 stored = GainSlot() < material.length() ? material[GainSlot()] : vec4(0.0);
        const bool have = stored.w > 0.0 && Finite(stored.rgb);
        vec3 gain = have ? stored.rgb : vec3(0.0);
        bool ok = have;
        if (s_n[0] >= MinSamples && all(greaterThan(s_dd[0], vec3(1e-8)))) {
            const vec3 fit = clamp(s_sd[0] / s_dd[0], vec3(0.0), vec3(1e3));
            if (Finite(fit)) {
                gain = have ? mix(stored.rgb, fit, Blend) : fit;
                ok = true;
                if (GainSlot() < material.length()) {
                    // w: whole part counts frames of history, fraction is the fit residual
                    // (0 = exact, near 1 = no correlation), for the debug readout.
                    const vec3 r2 = max(vec3(1.0) - s_sd[0] * s_sd[0] /
                                                        max(s_dd[0] * s_ss[0], vec3(1e-12)),
                                        vec3(0.0));
                    const float residual = clamp(sqrt(dot(r2, vec3(1.0 / 3.0))), 0.0, 0.999);
                    material[GainSlot()] =
                        vec4(gain, min(floor(stored.w) + 1.0, MaxFrames) + residual);
                }
            }
        }
        s_gain = gain;
        s_gain_ok = ok;
        if (GainSlot() + 1u < material.length()) {
            material[GainSlot() + 1u] = vec4(UOffset(), URepeat(), VDivisor(), 1.0);
        }
    }
    barrier();
    // Without a gain yet (too little sky on screen since the last material clear) only the cells
    // seen on screen are written; the rest stay as they are. Cells below the horizon take the
    // texture's bottom row, which is what the game draws on the dome's skirt there.
    const bool gain_ok = s_gain_ok;
    const vec3 gain = s_gain;
    vec3 up_sum = vec3(0.0);
    uint up_n = 0u;
    for (uint c = t; c < Cells; c += 256u) {
        const vec2 base = vec2(float(c % SkyProbeSize), float(c / SkyProbeSize));
        const uint seen = s_cell[c * 4u + 3u];
        if (seen == 0u && !gain_ok) {
            continue;
        }
        vec3 value;
        if (seen > 0u) {
            value = vec3(s_cell[c * 4u], s_cell[c * 4u + 1u], s_cell[c * 4u + 2u]) /
                    (CellScale * float(seen));
        } else {
            vec3 sum = vec3(0.0);
            for (int k = 0; k < 4; ++k) {
                const vec2 sub = vec2(float(k & 1), float(k >> 1)) * 0.5 + 0.25;
                sum += Dome(OctDecode((base + sub) / float(SkyProbeSize)), 4.0);
            }
            value = clamp(sum * 0.25 * gain, vec3(0.0), vec3(SkyClamp()));
        }
        if (OctDecode((base + 0.5) / float(SkyProbeSize)).y > 0.0) {
            up_sum += value;
            ++up_n;
        }
        const uint slot = ProbeBase() + c;
        if (slot < material.length()) {
            const vec4 stored = material[slot];
            const bool have = stored.w > 0.0 && Finite(stored.rgb);
            material[slot] = vec4(have ? mix(stored.rgb, value, Blend) : value,
                                  min(stored.w + 1.0, MaxFrames));
        }
    }
    barrier();
    s_ss[t] = up_sum;
    s_n[t] = up_n;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (t < stride) {
            s_ss[t] += s_ss[t + stride];
            s_n[t] += s_n[t + stride];
        }
        barrier();
    }
    if (t == 0u && s_n[0] > 0u && SkySlot() < material.length()) {
        const vec3 mean = s_ss[0] / float(s_n[0]);
        const vec4 stored = material[SkySlot()];
        const bool have = stored.w > 0.0 && Finite(stored.rgb);
        material[SkySlot()] = vec4(have ? mix(stored.rgb, mean, Blend) : mean,
                                   min(stored.w + 1.0, MaxFrames));
    }
}

// Debug 1: sky pixels (IsSky) show dome x gain (compare with the game's sky). Debug 2: 4x the absolute
// difference between the screen and dome x gain. Debug 3: the probe cell the GI reads.
// Debug 4: the fit residual as grey (black = dome matches the screen sky).
void DebugView() {
    const uint width = uint(Size().x);
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.x % width, gl_GlobalInvocationID.x / width);
    if (pixel.y >= int(Size().y)) {
        return;
    }
    const vec3 w = PixelWorldDir(vec2(pixel));
    if (!IsSky(pixel, w)) {
        return;
    }
    const vec4 g = GainSlot() < material.length() ? material[GainSlot()] : vec4(0.0);
    if (!(g.w > 0.0)) {
        return;
    }
    const vec3 s = imageLoad(scene_img, pixel).rgb;
    vec3 out_c = Dome(w, 0.0) * g.rgb;
    if (Debug() == 2u) {
        out_c = abs(s - out_c) * 4.0;
    } else if (Debug() == 3u) {
        const ivec2 c = clamp(ivec2(OctEncode(w) * float(SkyProbeSize)), ivec2(0),
                              ivec2(int(SkyProbeSize) - 1));
        const uint slot = ProbeBase() + uint(c.y) * SkyProbeSize + uint(c.x);
        out_c = slot < material.length() ? material[slot].rgb : vec3(0.0);
    } else if (Debug() == 4u) {
        out_c = vec3(fract(g.w));
    }
    imageStore(scene_img, pixel, vec4(out_c, 1.0));
}

// Phase 2: every second pixel in x and y stores the screen's sky into the sky image cell of
// its direction (the mirrors read it). Runs before the debug views overwrite the sky.
void CaptureSky() {
    const uint half_w = (uint(Size().x) + 1u) / 2u;
    const ivec2 pixel = 2 * ivec2(gl_GlobalInvocationID.x % half_w, gl_GlobalInvocationID.x / half_w);
    if (pixel.y >= int(Size().y) || pixel.x >= int(Size().x)) {
        return;
    }
    const vec3 w = PixelWorldDir(vec2(pixel));
    if (!Finite(w) || w.y < -0.05 || !IsSky(pixel, w)) {
        return;
    }
    const vec3 s = imageLoad(scene_img, pixel).rgb;
    if (!Finite(s)) {
        return;
    }
    const ivec2 c = clamp(ivec2(OctEncode(w) * float(SkyImageSize)), ivec2(0),
                          ivec2(int(SkyImageSize) - 1));
    const uint slot = ImageBase() + uint(c.y) * SkyImageSize + uint(c.x);
    if (slot < material.length()) {
        material[slot] = vec4(clamp(s, vec3(0.0), vec3(SkyClamp())), 1.0);
    }
}

void main() {
    if (Phase() == 0u) {
        FitAndFill();
    } else if (Phase() == 2u) {
        CaptureSky();
    } else {
        DebugView();
    }
}
