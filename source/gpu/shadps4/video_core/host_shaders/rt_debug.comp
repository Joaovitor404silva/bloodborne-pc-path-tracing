#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer TlasSpace {
    vec4 tlas_rows[3];
};

TlasSpace TlasSpaceOf(uvec2 tlas) {
    return TlasSpace(uvec2(tlas.x - 256u, tlas.y - (tlas.x < 256u ? 1u : 0u)));
}

vec3 TlasPoint(uvec2 tlas, vec3 p) {
    TlasSpace s = TlasSpaceOf(tlas);
    return vec3(dot(s.tlas_rows[0], vec4(p, 1.0)), dot(s.tlas_rows[1], vec4(p, 1.0)),
                dot(s.tlas_rows[2], vec4(p, 1.0)));
}

vec3 TlasDir(uvec2 tlas, vec3 d) {
    TlasSpace s = TlasSpaceOf(tlas);
    return vec3(dot(s.tlas_rows[0].xyz, d), dot(s.tlas_rows[1].xyz, d), dot(s.tlas_rows[2].xyz, d));
}

mat3 TlasToView(uvec2 tlas, mat3 m) {
    TlasSpace s = TlasSpaceOf(tlas);
    return mat3(s.tlas_rows[0].xyz, s.tlas_rows[1].xyz, s.tlas_rows[2].xyz) * m;
}

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D color_img;

layout(push_constant) uniform Constants {
    uvec2 tlas_address;
    vec2 proj_scale;
    vec2 size;
    uint mode;
    uint frame;
    float range;
    float ao_radius;
};

const uint AoRays = 8u;

vec3 Direction(vec2 pixel) {
    const vec2 uv = (pixel + 0.5) / size;
    const vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    return normalize(vec3(ndc.x / proj_scale.x, ndc.y / proj_scale.y, 1.0));
}

float Trace(vec3 origin, vec3 dir, float t_max) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, accelerationStructureEXT(tlas_address), gl_RayFlagsOpaqueEXT, 0x01u,
                          TlasPoint(tlas_address, origin), 0.0, TlasDir(tlas_address, dir), t_max);
    while (rayQueryProceedEXT(q)) {
    }
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        return rayQueryGetIntersectionTEXT(q, true);
    }
    return -1.0;
}

uint Hash(uint x) {
    x ^= x >> 16u;
    x *= 0x7feb352du;
    x ^= x >> 15u;
    x *= 0x846ca68bu;
    x ^= x >> 16u;
    return x;
}

float Random(inout uint state) {
    state = Hash(state);
    return float(state & 0x00FFFFFFu) / 16777216.0;
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    const vec3 dir = Direction(vec2(pixel));
    const float t_max = 1e6;
    const float t = Trace(vec3(0.0), dir, t_max);
    const vec4 current = imageLoad(color_img, pixel);
    const vec3 miss_color = vec3(0.1, 0.1, 0.3);
    vec3 result = current.rgb;
    if (mode == 1u || mode == 3u) {
        const vec3 distance_color = t < 0.0 ? miss_color : vec3(exp(-t * dir.z / range));
        result = mode == 1u ? distance_color : mix(current.rgb, distance_color, 0.5);
    } else if (mode == 2u || mode == 4u) {
        float ao = 1.0;
        if (t >= 0.0) {
            const vec3 p = dir * t;
            const vec3 dir_x = Direction(vec2(pixel) + vec2(1.0, 0.0));
            const vec3 dir_y = Direction(vec2(pixel) + vec2(0.0, 1.0));
            const float tx = Trace(vec3(0.0), dir_x, t_max);
            const float ty = Trace(vec3(0.0), dir_y, t_max);
            vec3 n = -dir;
            if (tx >= 0.0 && ty >= 0.0) {
                const vec3 c = cross(dir_x * tx - p, dir_y * ty - p);
                if (dot(c, c) > 0.0) {
                    n = normalize(c);
                    if (dot(n, dir) > 0.0) {
                        n = -n;
                    }
                }
            }
            const vec3 helper = abs(n.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
            const vec3 tangent = normalize(cross(helper, n));
            const vec3 bitangent = cross(n, tangent);
            const vec3 origin = p + n * (0.01 + t * 2e-4);
            uint state = Hash(uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + frame * 26699u);
            float occluded = 0.0;
            for (uint i = 0u; i < AoRays; ++i) {
                const float u1 = Random(state);
                const float u2 = Random(state);
                const float r = sqrt(u1);
                const float phi = 6.28318530718 * u2;
                const vec3 local = vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u1)));
                const vec3 sample_dir = tangent * local.x + bitangent * local.y + n * local.z;
                if (Trace(origin, sample_dir, ao_radius) >= 0.0) {
                    occluded += 1.0;
                }
            }
            ao = 1.0 - occluded / float(AoRays);
        }
        result = mode == 2u ? (t < 0.0 ? miss_color : vec3(ao)) : current.rgb * ao;
    }
    imageStore(color_img, pixel, vec4(result, current.a));
}
